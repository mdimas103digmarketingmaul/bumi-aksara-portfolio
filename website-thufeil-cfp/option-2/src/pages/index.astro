---
import Base from '../layouts/Base.astro';
import Preloader from '../components/Preloader.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Manifesto from '../components/Manifesto.astro';
import Credentials from '../components/Credentials.astro';
import Expertise from '../components/Expertise.astro';
import Testimonials from '../components/Testimonials.astro';
import Insight from '../components/Insight.astro';
import Consultation from '../components/Consultation.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';
---

<Base>
  <Preloader />
  <Nav />
  <main id="main" class="main">
    <Hero />
    <Manifesto />
    <Credentials />
    <Expertise />
    <Testimonials />
    <Insight />
    <Consultation />
  </main>
  <Footer />
  <Lightbox />
</Base>

<style>
  /* Main sits above the footer so the footer can be revealed from underneath. */
  .main {
    position: relative;
    z-index: 2;
  }
</style>
