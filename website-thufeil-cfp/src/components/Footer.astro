---
import { Image } from 'astro:assets';
import ifacLogo from '../assets/brand/ifac-logo.png';
import Icon from './Icon.astro';
import { bookingAnchor, contact, site } from '../config/profile';
import { certificate, expertise } from '../data/content';

const year = new Date().getFullYear();

// Placeholder channels: plain text until real accounts are connected.
const channels = [
  { icon: 'instagram' as const, label: `Instagram ${contact.instagramHandle}` },
  { icon: 'whatsapp' as const, label: `WhatsApp ${contact.whatsappDisplay}` },
];

const explore = [
  { href: '#tentang', label: 'Tentang' },
  { href: '#kredensial', label: 'Kredensial' },
  { href: '#keahlian', label: 'Keahlian' },
  { href: '#testimoni', label: 'Testimoni' },
  { href: '#insight', label: 'Insight' },
  { href: bookingAnchor, label: 'Konsultasi' },
];

const socials = [
  { label: 'Instagram', icon: 'instagram' as const },
  { label: 'Threads', icon: 'threads' as const },
];
---

<footer class="foot" data-foot>
  <div class="foot__inner wrap">
    <div class="foot__top">
      <p class="foot__brand">
        {site.fullName}, CFP®
        <span>{site.role}</span>
      </p>
      <ul class="foot__social" role="list">
        {
          socials.map((s) => (
            <li>
              <span role="img" aria-label={`${s.label} (segera hadir)`} title={`${s.label} · segera hadir`}>
                <Icon name={s.icon} />
              </span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="foot__cols">
      <div class="foot__col">
        <h2 class="foot__head">Hubungi</h2>
        <p class="foot__loc"><Icon name="pin" />{site.location}</p>
        <ul class="foot__list" role="list">
          {
            channels.map((c) => (
              <li class="foot__channel">
                <Icon name={c.icon} />
                {c.label}
              </li>
            ))
          }
          <li><a href={bookingAnchor}>Konsultasi gratis 30 menit</a></li>
        </ul>
      </div>

      <nav class="foot__col" aria-label="Navigasi footer">
        <h2 class="foot__head">Jelajahi</h2>
        <ul class="foot__list" role="list">
          {explore.map((l) => (<li><a href={l.href}>{l.label}</a></li>))}
        </ul>
      </nav>

      <div class="foot__col">
        <h2 class="foot__head">Topik diskusi</h2>
        <ul class="foot__list" role="list">
          {expertise.map((e) => (<li><a href="#keahlian">{e.title}</a></li>))}
        </ul>
      </div>

      <div class="foot__col">
        <h2 class="foot__head">Terdaftar di</h2>
        <span class="foot__ifac">
          <Image src={ifacLogo} width={185} height={68} alt="IFAC — Indonesia Financial Advisor Community" />
        </span>
        <p class="foot__cert">
          {certificate.mark} · {certificate.issuer}<br />
          No. {certificate.number}
        </p>
      </div>
    </div>

    <div class="foot__bottom">
      <p>© {year} {site.fullName}</p>
      <a href="#top" class="foot__up">
        Kembali ke atas
        <Icon name="up" />
      </a>
    </div>
  </div>
</footer>

<style>
  .foot {
    position: relative;
    z-index: 1;
    background: var(--night);
    color: var(--cream);
    padding-top: calc(var(--r-lg) + clamp(3rem, 2rem + 3vw, 5rem));
    margin-top: calc(var(--r-lg) * -1);
    overflow: hidden;
  }

  /* Footer is revealed from underneath the closing section on larger screens. */
  @media (min-width: 48rem) and (min-height: 44rem) {
    .foot {
      position: sticky;
      bottom: 0;
    }
  }

  .foot__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-bottom: clamp(1.75rem, 1.25rem + 1.5vw, 2.5rem);
    border-bottom: 1px solid var(--line-d);
  }

  .foot__brand {
    display: grid;
    gap: 0.2rem;
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .foot__brand span {
    font-size: var(--t-small);
    font-weight: 400;
    color: var(--sun);
  }

  .foot__social {
    display: flex;
    gap: 0.5rem;
  }

  .foot__social span {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px var(--line-d);
    color: var(--cream);
    transition:
      background-color 0.4s var(--ease),
      color 0.4s var(--ease);
  }

  .foot__social span:hover {
    color: var(--sun);
  }

  .foot__social .icon {
    width: 1.2rem;
    height: 1.2rem;
  }

  /* ─── Columns ─── */
  .foot__cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem 1.5rem;
    padding-block: clamp(2.5rem, 2rem + 2vw, 3.5rem);
  }

  @media (min-width: 60rem) {
    .foot__cols {
      grid-template-columns: 1.1fr 0.9fr 1.1fr 1fr;
      gap: 2rem;
    }
  }

  .foot__head {
    margin-bottom: 1rem;
    font-size: var(--t-label);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fog-2);
  }

  .foot__list {
    display: grid;
    gap: 0.55rem;
  }

  .foot__list a {
    font-size: 0.9375rem;
    color: var(--fog);
    text-decoration: none;
    transition: color 0.3s var(--ease);
  }

  .foot__list a:hover {
    color: var(--sun);
  }

  .foot__channel {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.9375rem;
    color: var(--fog);
  }

  .foot__channel .icon {
    width: 1rem;
    height: 1rem;
    flex: none;
  }

  .foot__loc {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 0.9rem;
    font-size: 0.9375rem;
    color: var(--cream);
  }

  .foot__loc .icon {
    width: 1rem;
    height: 1rem;
    color: var(--sun);
  }

  .foot__ifac {
    display: inline-block;
    padding: 0.55rem 0.75rem;
    border-radius: 0.75rem;
    background: #fff;
    transition: transform 0.5s var(--ease);
  }


  .foot__ifac :global(img) {
    width: 9.5rem;
    height: auto;
  }

  .foot__cert {
    margin-top: 1rem;
    font-size: var(--t-small);
    line-height: 1.55;
    color: var(--fog);
  }

  /* ─── Bottom ─── */
  .foot__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.5rem max(1.5rem, env(safe-area-inset-bottom));
    border-top: 1px solid var(--line-d);
    font-size: var(--t-small);
    color: var(--fog-2);
  }

  .foot__up {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--fog);
    text-decoration: none;
  }

  .foot__up:hover {
    color: var(--sun);
  }

  .foot__up .icon {
    width: 0.9rem;
    height: 0.9rem;
  }
</style>
