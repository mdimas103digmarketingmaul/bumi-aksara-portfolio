---
// Minimal stroke icon set. Only icons that carry meaning (external link,
// platform, close, navigation) — never decoration.
interface Props {
  name: 'external' | 'instagram' | 'whatsapp' | 'close' | 'prev' | 'next' | 'expand' | 'menu';
  class?: string;
}
const { name, class: className = 'icon' } = Astro.props;
---

<svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'external' && <path d="M8 16 16 8M9.5 8H16v6.5" />}
  {name === 'instagram' && (
    <Fragment>
      <rect x="3.5" y="3.5" width="17" height="17" rx="4.5" />
      <circle cx="12" cy="12" r="3.8" />
      <circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" stroke="none" />
    </Fragment>
  )}
  {name === 'whatsapp' && (
    <path d="M4 20l1.2-4A8 8 0 1 1 8 18.8L4 20Zm5.1-11.3c-.3.9 0 2.2 1.3 3.6 1.4 1.5 2.8 2 3.7 1.7l.8-1.1-1.6-.9-.7.7c-.6-.2-1.6-1-2-1.9l.6-.7-.8-1.7-1.3.3Z" />
  )}
  {name === 'close' && <path d="M6 6l12 12M18 6 6 18" />}
  {name === 'prev' && <path d="M14.5 6 8.5 12l6 6" />}
  {name === 'next' && <path d="M9.5 6l6 6-6 6" />}
  {name === 'expand' && <path d="M14 4h6v6M10 20H4v-6M20 4l-6.5 6.5M4 20l6.5-6.5" />}
  {name === 'menu' && <path d="M4 8h16M4 16h16" />}
</svg>
