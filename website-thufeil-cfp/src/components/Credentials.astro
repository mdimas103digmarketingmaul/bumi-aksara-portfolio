---
import Icon from './Icon.astro';
import cert from '../assets/credentials/sertifikat-cfp.jpg';
import { certificate, credentials } from '../data/content';
import { links } from '../config/site';
---

<section class="section creds" id="kredensial" aria-labelledby="creds-title">
  <div class="container">
    <header class="creds__head" data-reveal>
      <span class="eyebrow">Kredensial</span>
      <h2 class="h2" id="creds-title">Kredensial yang bisa <em>kamu cek</em>.</h2>
    </header>

    <div class="creds__grid">
      <article class="cfp" data-reveal>
        <p class="cfp__mark" aria-hidden="true">CFP<sup>®</sup></p>
        <h3 class="cfp__name">{certificate.mark} — {certificate.name}</h3>
        <p class="cfp__desc">
          Sertifikasi perencana keuangan dari Financial Planning Standards Board, dengan syarat pendidikan, ujian,
          pengalaman, dan kode etik profesi.
        </p>

        <dl class="cfp__meta">
          <div>
            <dt>Penerbit</dt>
            <dd>{certificate.issuer}</dd>
          </div>
          <div>
            <dt>No. sertifikat</dt>
            <dd>{certificate.number}</dd>
          </div>
          <div>
            <dt>Berlaku hingga</dt>
            <dd>{certificate.validUntil}</dd>
          </div>
        </dl>

        <button
          class="btn btn--outline cfp__btn"
          type="button"
          aria-haspopup="dialog"
          data-lightbox="certificate"
          data-src={cert.src}
          data-width={cert.width}
          data-height={cert.height}
          data-alt="Sertifikat Certified Financial Planner atas nama Thufeil Muhammad Tyansah, nomor 2500 0725, berlaku hingga 31 Desember 2027, diterbitkan FPSB Indonesia."
          data-caption="Sertifikat CFP® — FPSB Indonesia"
        >
          <Icon name="expand" />
          Lihat Sertifikat CFP®
        </button>
      </article>

      <div class="others" data-reveal style="--reveal-delay: 120ms">
        <h3 class="others__title">Sertifikasi &amp; pendidikan lain</h3>
        <ul class="others__list" role="list">
          {
            credentials.map((c) => (
              <li>
                <span class="others__code">{c.code}</span>
                <span class="others__name">{c.name}</span>
              </li>
            ))
          }
        </ul>

        <div class="member">
          <p>Registered Member, <span class="member__org">Indonesia Financial Advisor Community (IFAC)</span></p>
          <a class="text-link" href={links.ifacProfile} target="_blank" rel="noopener noreferrer">
            Lihat profil di IFAC
            <Icon name="external" />
            <span class="sr-only">(tab baru)</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .creds {
    border-top: 1px solid var(--line);
  }

  .creds__head {
    display: grid;
    gap: 1rem;
    max-width: 40rem;
    margin-bottom: clamp(2.5rem, 2rem + 3vw, 4.5rem);
  }

  .creds__grid {
    display: grid;
    gap: clamp(3rem, 2rem + 4vw, 5rem);
  }

  @media (min-width: 60rem) {
    .creds__grid {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      gap: clamp(3rem, 7vw, 7.5rem);
      align-items: start;
    }
  }

  /* CFP® gets the typographic weight; the rest stays quiet. */
  .cfp {
    border-top: 2px solid var(--ink);
    padding-top: 1.25rem;
  }

  .cfp__mark {
    font-family: var(--font-display);
    font-size: clamp(6rem, 3rem + 13vw, 12rem);
    line-height: 0.82;
    letter-spacing: -0.03em;
    margin-top: 0.6rem;
  }

  .cfp__mark sup {
    font-family: var(--font-sans);
    font-size: 0.16em;
    font-weight: 500;
    vertical-align: top;
    position: relative;
    top: 0.5em;
    margin-left: 0.15em;
    letter-spacing: 0;
  }

  .cfp__name {
    margin-top: 1.5rem;
    font-size: var(--fs-h3);
    font-weight: 650;
    line-height: 1.3;
  }

  .cfp__desc {
    margin-top: 0.6rem;
    max-width: 30rem;
    color: var(--ink-2);
  }

  .cfp__meta {
    display: grid;
    grid-template-columns: repeat(3, auto);
    justify-content: start;
    gap: 0.75rem clamp(1.5rem, 4vw, 3rem);
    margin-block: 1.75rem 2rem;
    padding-block: 1rem;
    border-block: 1px solid var(--line);
  }

  .cfp__meta dt {
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .cfp__meta dd {
    margin: 0.2rem 0 0;
    font-size: var(--fs-small);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 30rem) {
    .cfp__meta {
      grid-template-columns: 1fr 1fr;
    }

    .cfp__meta div:last-child {
      grid-column: 1 / -1;
    }

    .cfp__btn {
      width: 100%;
    }
  }

  .others__title {
    font-size: var(--fs-label);
    font-weight: 650;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-3);
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line-strong);
  }

  @media (min-width: 60rem) {
    .others {
      padding-top: 1.25rem;
    }
  }

  .others__list li {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: 1rem;
    align-items: baseline;
    padding-block: 0.95rem;
    border-bottom: 1px solid var(--line);
  }

  .others__code {
    font-size: var(--fs-small);
    font-weight: 700;
    color: var(--green);
    letter-spacing: 0.02em;
  }

  .others__name {
    font-size: 0.9375rem;
  }

  .member {
    display: grid;
    gap: 0.75rem;
    justify-items: start;
    margin-top: 2rem;
    font-size: 0.9375rem;
    color: var(--ink-2);
  }

  .member__org {
    color: var(--ink);
    font-weight: 600;
  }
</style>
