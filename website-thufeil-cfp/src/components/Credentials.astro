---
import Icon from './Icon.astro';
import { certificate, credentials } from '../data/content';

// Code-drawn placeholder until the real certificate scan is supplied.
const cert = { src: '/placeholder/certificate.svg', width: 1600, height: 1131 };
const certAlt = 'Placeholder sertifikat bertuliskan Certificate, Certified Financial Planner.';
---

<section class="cred" id="kredensial" aria-labelledby="cred-title">
  <div class="wrap cred__grid">
    <div class="cred__copy">
      <p class="label label--sun" data-reveal>Kredensial</p>
      <h2 class="cred__title display" id="cred-title" data-split>Sertifikasi Keuangan</h2>

      <div class="cred__cfp" data-reveal>
        <p class="cred__cfp-name"><strong>CFP®</strong> — Certified Financial Planner</p>
        <p class="cred__cfp-desc">
          Sertifikasi perencana keuangan dari Financial Planning Standards Board, dengan syarat pendidikan, ujian,
          pengalaman, dan kode etik profesi.
        </p>
        <dl class="cred__meta">
          <div><dt>Penerbit</dt><dd>{certificate.issuer}</dd></div>
          <div><dt>No. sertifikat</dt><dd>{certificate.number}</dd></div>
          <div><dt>Berlaku hingga</dt><dd>{certificate.validUntil}</dd></div>
        </dl>
      </div>
    </div>

    <div class="cred__visual">
      <div class="cert" data-cert>
        <button
          class="cert__card"
          type="button"
          aria-haspopup="dialog"
          data-cert-card
          data-lightbox="certificate"
          data-src={cert.src}
          data-width={cert.width}
          data-height={cert.height}
          data-alt={certAlt}
          data-caption="Certificate · placeholder"
        >
          <span class="cert__tilt" data-cert-tilt>
            <img src={cert.src} width={cert.width} height={cert.height} alt={certAlt} loading="lazy" decoding="async" />
            <span class="cert__shine" aria-hidden="true"></span>
          </span>
          <span class="cert__hint">
            <Icon name="expand" />
            Lihat Sertifikat CFP®
          </span>
        </button>
      </div>
    </div>

    <div class="cred__others">
      <p class="cred__others-title" data-reveal>Sertifikasi &amp; pendidikan lain</p>
      <ul class="cred__list" role="list">
        {
          credentials.map((c) => (
            <li class="cred__row" data-reveal>
              <span class="cred__code display">{c.code}</span>
              <span class="cred__name">{c.name}</span>
            </li>
          ))
        }
      </ul>
      <p class="cred__member" data-reveal>
        Registered Member, Indonesia Financial Advisor Community (IFAC).
      </p>
    </div>
  </div>
</section>

<style>
  .cred {
    position: relative;
    padding-block: var(--section);
    background: var(--night);
  }

  .cred__grid {
    display: grid;
    gap: clamp(3rem, 2rem + 4vw, 5rem);
  }

  @media (min-width: 64rem) {
    .cred__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      grid-template-areas:
        'copy visual'
        'others visual';
      column-gap: clamp(3rem, 6vw, 7rem);
      row-gap: 4rem;
    }

    .cred__copy {
      grid-area: copy;
    }

    .cred__visual {
      grid-area: visual;
      position: sticky;
      top: calc(var(--nav-h) + 3rem);
      align-self: start;
    }

    .cred__others {
      grid-area: others;
    }
  }

  .cred__title {
    margin-top: 1.25rem;
    font-size: var(--t-lg);
  }

  .cred__cfp {
    margin-top: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  .cred__cfp-name {
    font-size: 1.125rem;
  }

  .cred__cfp-name strong {
    color: var(--sun);
    font-weight: 600;
  }

  .cred__cfp-desc {
    margin-top: 0.6rem;
    max-width: 30rem;
    color: var(--fog);
  }

  .cred__meta {
    display: grid;
    grid-template-columns: repeat(3, auto);
    justify-content: start;
    gap: 0.75rem clamp(1.5rem, 4vw, 2.75rem);
    margin-top: 1.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line-d);
  }

  .cred__meta dt {
    font-size: var(--t-label);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fog-2);
  }

  .cred__meta dd {
    margin: 0.25rem 0 0;
    font-weight: 550;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 30rem) {
    .cred__meta {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* ─── Certificate as a physical object ─── */
  .cert {
    perspective: 1400px;
  }

  .cert__card {
    display: grid;
    gap: 1.25rem;
    justify-items: center;
    width: 100%;
    cursor: zoom-in;
    transform-style: preserve-3d;
  }

  .cert__tilt {
    position: relative;
    display: block;
    width: 100%;
    padding: clamp(0.5rem, 0.3rem + 0.6vw, 0.9rem);
    border-radius: 14px;
    background: #fff;
    box-shadow:
      0 2px 0 rgb(255 255 255 / 0.6) inset,
      0 40px 80px -20px rgb(0 0 0 / 0.65),
      0 18px 30px -18px rgb(0 0 0 / 0.5);
    transform-style: preserve-3d;
    will-change: transform;
  }

  .cert__tilt img {
    width: 100%;
    height: auto;
    border-radius: 6px;
  }

  .cert__shine {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(
      circle at var(--sx, 30%) var(--sy, 20%),
      rgb(255 255 255 / 0.45),
      transparent 45%
    );
    mix-blend-mode: soft-light;
    opacity: 0;
    transition: opacity 0.4s var(--ease);
    pointer-events: none;
  }

  .cert__card:hover .cert__shine {
    opacity: 1;
  }

  .cert__hint {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.8rem 1.3rem;
    border-radius: 999px;
    background: rgb(243 239 230 / 0.08);
    box-shadow: inset 0 0 0 1px var(--line-d);
    font-size: 0.9375rem;
    font-weight: 550;
    transition: background-color 0.3s var(--ease);
  }

  .cert__card:hover .cert__hint {
    background: var(--sun);
    color: var(--ink);
  }

  /* ─── Other credentials ─── */
  .cred__others-title {
    font-size: var(--t-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fog-2);
    padding-bottom: 1rem;
  }

  .cred__row {
    position: relative;
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: 1rem;
    align-items: baseline;
    padding-block: 1.05rem;
    border-top: 1px solid var(--line-d);
  }

  .cred__row:last-child {
    border-bottom: 1px solid var(--line-d);
  }

  .cred__row::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: -1px;
    height: 1px;
    background: var(--sun);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.7s var(--ease);
  }

  .cred__row:hover::after {
    transform: scaleX(1);
  }

  .cred__code {
    text-transform: none;
    font-size: 1.6rem;
    line-height: 1;
    color: var(--sun);
  }

  .cred__name {
    font-size: 0.975rem;
    color: var(--cream);
  }

  .cred__member {
    margin-top: 1.5rem;
    font-size: var(--t-small);
    color: var(--fog);
  }

</style>
