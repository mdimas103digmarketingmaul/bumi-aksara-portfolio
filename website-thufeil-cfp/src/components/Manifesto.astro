---
import { about } from '../data/content';
import { site } from '../config/profile';

const fmt = new Intl.NumberFormat('id-ID');
---

<section class="mani on-light" id="tentang" aria-labelledby="mani-title">
  <div class="wrap">
    <h2 class="label" id="mani-title" data-reveal>Tentang {site.firstName}</h2>

    <p class="mani__text" data-scrub-words>
      {site.firstName} adalah perencana keuangan syariah bersertifikat CFP® yang percaya <mark>uang yang tertata bikin hidup lebih tenang</mark>.
    </p>

    <ul class="mani__stats" role="list">
      {
        about.stats.map((s) => (
          <li class="stat" data-reveal>
            <p class="stat__num display">
              <span data-count={s.value}>{fmt.format(s.value)}</span>
              {s.suffix}
            </p>
            <p class="stat__label">{s.label}</p>
          </li>
        ))
      }
      <li class="stat stat--mission" data-reveal>
        <p class="stat__tag">Misi</p>
        <p class="stat__mission">{about.mission}</p>
      </li>
    </ul>

    <div class="mani__grid">
      <div class="mani__story" data-reveal>
        <p class="mani__lede">Buat {site.firstName}, setiap dompet punya ceritanya sendiri.</p>
        <p class="mani__body">
          Rumus keuangan yang cocok untuk orang lain belum tentu cocok untukmu, karena yang paling menentukan
          adalah <span class="hl" data-hl>kebiasaan dan cara pandang soal uang</span>. Karena itu setiap sesi
          diawali dengan mendengar, lalu bersama-sama <span class="hl" data-hl>merancang langkah kecil yang bisa
          langsung dijalankan</span> tanpa keluar dari prinsip syariah.
        </p>
      </div>

      <figure class="mani__quote" data-reveal>
        <blockquote>
          <p>“{about.principle}”</p>
        </blockquote>
        <figcaption>Prinsip yang dipegang {site.firstName}</figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .mani {
    position: relative;
    z-index: 2;
    margin-top: calc(var(--r-lg) * -1);
    border-radius: var(--r-lg) var(--r-lg) 0 0;
    padding-block: var(--section);
  }

  .mani__text {
    margin-top: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    max-width: 21em;
    font-family: var(--f-display);
    font-stretch: 88%;
    font-weight: 600;
    font-size: clamp(2rem, 1.15rem + 3.4vw, 4.5rem);
    line-height: 1.06;
    letter-spacing: -0.02em;
  }

  .mani__text mark {
    background: none;
    color: inherit;
    box-shadow: inset 0 -0.32em 0 var(--sun);
  }

  /* ─── Numbers ─── */
  .mani__stats {
    display: grid;
    margin-top: clamp(3.5rem, 2.5rem + 4vw, 6.5rem);
  }

  .stat {
    display: grid;
    grid-template-columns: minmax(0, 9rem) minmax(0, 1fr);
    align-items: center;
    gap: 1.25rem;
    padding-block: 1.25rem;
    border-top: 1px solid var(--line-l);
  }

  .stat:last-child {
    border-bottom: 1px solid var(--line-l);
  }

  .stat__num {
    font-size: clamp(2.75rem, 1.5rem + 4.4vw, 6rem);
    line-height: 0.85;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .stat__label {
    max-width: 18rem;
    font-size: 0.9375rem;
    line-height: 1.45;
    color: var(--ink-soft);
  }

  /* The mission is a goal, so it reads as a sentence rather than a number. */
  .stat--mission {
    grid-template-columns: 1fr;
    gap: 0.5rem;
  }

  .stat__tag {
    font-size: var(--t-label);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .stat__mission {
    max-width: 20rem;
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem);
    font-weight: 550;
    line-height: 1.35;
  }

  @media (min-width: 48rem) {
    .mani__stats {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(1.5rem, 3vw, 3rem);
    }

    .stat,
    .stat:last-child {
      grid-template-columns: 1fr;
      align-content: start;
      gap: 1rem;
      padding-block: 1.5rem 0;
      border-bottom: 0;
    }
  }

  /* ─── Story + quote ─── */
  .mani__grid {
    display: grid;
    gap: 2.5rem;
    margin-top: clamp(3rem, 2rem + 4vw, 6rem);
  }

  @media (min-width: 56rem) {
    .mani__grid {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      gap: clamp(3rem, 8vw, 8rem);
      align-items: start;
    }
  }

  .mani__story {
    max-width: 38rem;
  }

  .mani__lede {
    font-family: var(--f-display);
    font-stretch: 88%;
    font-weight: 650;
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.25rem);
    line-height: 1.15;
    letter-spacing: -0.015em;
  }

  .mani__body {
    margin-top: 1rem;
    font-size: var(--t-lead);
    line-height: 1.65;
    color: var(--ink-soft);
  }

  /* Marker underline; motion.ts draws it in when the paragraph is read. */
  .hl {
    color: var(--ink);
    font-weight: 550;
    background: linear-gradient(var(--sun), var(--sun)) 0 92% / 100% 0.38em no-repeat;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  .mani__quote {
    padding-left: 1.25rem;
    border-left: 2px solid var(--sun);
  }

  .mani__quote blockquote p {
    max-width: 24rem;
    font-size: 1.0625rem;
    font-style: italic;
    line-height: 1.5;
    color: var(--ink-soft);
  }

  .mani__quote figcaption {
    margin-top: 0.6rem;
    font-size: var(--t-label);
    font-weight: 550;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
</style>
