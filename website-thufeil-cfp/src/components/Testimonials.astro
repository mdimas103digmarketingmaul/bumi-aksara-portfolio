---
import { Image, getImage } from 'astro:assets';
import Icon from './Icon.astro';
import { testimonials } from '../data/content';

// Larger renditions for the lightbox; thumbnails are generated by <Image>.
const items = await Promise.all(
  testimonials.map(async (t) => {
    const full = await getImage({ src: t.image, width: 1100, format: 'webp', quality: 84 });
    return { ...t, full };
  }),
);
const total = items.length;
---

<section class="section testi on-dark" id="testimoni" aria-labelledby="testi-title">
  <div class="container testi__head">
    <div class="testi__head-main" data-reveal>
      <span class="eyebrow">Testimoni</span>
      <h2 class="h2" id="testi-title">Mereka yang sudah <em>ngobrol duluan</em>.</h2>
    </div>
    <div class="testi__head-side" data-reveal style="--reveal-delay: 100ms">
      <p class="lead">
        Story Instagram dari peserta financial check-up dan sesi diskusi. Ditampilkan apa adanya, buka untuk membaca lebih jelas.
      </p>
      <div class="testi__controls" data-carousel-controls>
        <button class="testi__arrow" type="button" data-carousel-prev aria-controls="testi-track">
          <Icon name="prev" />
          <span class="sr-only">Testimoni sebelumnya</span>
        </button>
        <button class="testi__arrow" type="button" data-carousel-next aria-controls="testi-track">
          <Icon name="next" />
          <span class="sr-only">Testimoni berikutnya</span>
        </button>
      </div>
    </div>
  </div>

  <div class="testi__viewport">
    <ul class="testi__track" id="testi-track" role="list" aria-label={`${total} screenshot testimoni`} data-carousel-track>
      {
        items.map((t, i) => (
          <li class="testi__item">
            <button
              class="story"
              type="button"
              aria-haspopup="dialog"
              data-lightbox="testimonials"
              data-src={t.full.src}
              data-width={t.full.attributes.width}
              data-height={t.full.attributes.height}
              data-alt={t.alt}
              data-caption={`Testimoni ${i + 1} dari ${total}`}
            >
              <Image
                class="story__img"
                src={t.image}
                widths={[280, 420, 560]}
                sizes="(min-width: 64rem) 16.5rem, (min-width: 40rem) 14rem, 62vw"
                format="webp"
                quality={80}
                loading="lazy"
                alt={t.alt}
              />
              <span class="story__zoom" aria-hidden="true">
                <Icon name="expand" />
              </span>
            </button>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="container">
    <div class="testi__progress" aria-hidden="true">
      <span data-carousel-progress></span>
    </div>
  </div>
</section>

<style>
  .testi {
    background: var(--navy);
    color: var(--on-dark);
    overflow: hidden;
  }

  .testi__head {
    display: grid;
    gap: 1.5rem;
    margin-bottom: clamp(2.5rem, 2rem + 2.5vw, 4rem);
  }

  .testi__head-main {
    display: grid;
    gap: 1rem;
  }

  .testi__head-side {
    display: grid;
    gap: 1.5rem;
  }

  .testi__head .lead {
    max-width: 26rem;
  }

  @media (min-width: 60rem) {
    .testi__head {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      align-items: end;
      gap: 3rem;
    }
  }

  .testi__controls {
    display: flex;
    gap: 0.5rem;
  }

  .testi__arrow {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    border: 1px solid var(--line-dark);
    transition:
      background-color 0.2s var(--ease-out),
      border-color 0.2s var(--ease-out),
      opacity 0.2s var(--ease-out);
  }

  .testi__arrow:hover:not(:disabled) {
    background: rgb(243 238 227 / 0.08);
    border-color: rgb(243 238 227 / 0.45);
  }

  .testi__arrow:disabled {
    opacity: 0.3;
    cursor: default;
  }

  .testi__arrow .icon {
    width: 1.25rem;
    height: 1.25rem;
  }

  /* The track starts aligned with the container and bleeds off the right edge. */
  .testi__viewport {
    --inset: max(var(--gutter), calc((100vw - var(--max)) / 2));
  }

  .testi__track {
    display: flex;
    gap: clamp(0.875rem, 0.5rem + 1.2vw, 1.5rem);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--inset);
    padding-inline: var(--inset);
    padding-block: 0.5rem 2.5rem;
    scrollbar-width: none;
  }

  .testi__track::-webkit-scrollbar {
    display: none;
  }

  .testi__item {
    flex: none;
    width: clamp(13.5rem, 62vw, 16.5rem);
    scroll-snap-align: start;
  }

  @media (min-width: 40rem) {
    .testi__item {
      width: 14rem;
    }
  }

  @media (min-width: 64rem) {
    .testi__item {
      width: 16.5rem;
    }
  }

  .story {
    position: relative;
    display: block;
    width: 100%;
    border-radius: 8px;
    overflow: hidden;
    background: var(--navy-2);
    box-shadow: 0 0 0 1px var(--line-dark);
    cursor: zoom-in;
  }

  .story__img {
    width: 100%;
    height: auto;
    transition: transform 0.6s var(--ease-out);
  }

  .story:hover .story__img {
    transform: scale(1.025);
  }

  .story__zoom {
    position: absolute;
    right: 0.6rem;
    bottom: 0.6rem;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: rgb(12 15 30 / 0.72);
    color: var(--on-dark);
  }

  .story__zoom .icon {
    width: 1rem;
    height: 1rem;
  }

  .story:focus-visible {
    outline-offset: 4px;
  }

  .testi__progress {
    height: 1px;
    background: var(--line-dark);
    position: relative;
    overflow: hidden;
  }

  .testi__progress span {
    position: absolute;
    inset: 0;
    background: var(--on-dark);
    transform-origin: left;
    transform: scaleX(var(--progress, 0.1));
    transition: transform 0.15s linear;
  }
</style>

<script>
  const track = document.querySelector<HTMLElement>('[data-carousel-track]');
  const prev = document.querySelector<HTMLButtonElement>('[data-carousel-prev]');
  const next = document.querySelector<HTMLButtonElement>('[data-carousel-next]');
  const bar = document.querySelector<HTMLElement>('[data-carousel-progress]');

  if (track && prev && next && bar) {
    const step = () => {
      const item = track.querySelector<HTMLElement>('li');
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      const per = item ? item.offsetWidth + gap : track.clientWidth;
      // Move by as many whole cards as fit, minus one so context is kept.
      return per * Math.max(1, Math.floor(track.clientWidth / per) - 1);
    };

    const update = () => {
      const max = track.scrollWidth - track.clientWidth;
      const x = track.scrollLeft;
      prev.disabled = x <= 2;
      next.disabled = x >= max - 2;
      const visible = track.clientWidth / track.scrollWidth;
      const ratio = max > 0 ? x / max : 1;
      bar.style.setProperty('--progress', String(visible + (1 - visible) * ratio));
    };

    prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
    track.addEventListener('scroll', () => requestAnimationFrame(update), { passive: true });
    window.addEventListener('resize', update);
    update();
  }
</script>
