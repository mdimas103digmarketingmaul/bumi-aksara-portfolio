---
import Icon from './Icon.astro';
import { testimonials } from '../data/content';

const total = testimonials.length;
const initials = (name: string) =>
  name
    .split(/\s*&\s*|\s+/)
    .map((part) => part.charAt(0))
    .join('')
    .slice(0, 2)
    .toUpperCase();
---

<section class="testi" id="testimoni" aria-labelledby="testi-title" data-rail data-autoplay="3500">
  <header class="testi__head wrap">
    <div>
      <p class="label label--sun" data-reveal>Testimoni</p>
      <h2 class="testi__title display" id="testi-title" data-split>Kata mereka, setelah ngobrol.</h2>
    </div>
    <div class="rail__controls" data-reveal>
      <button class="rail__btn" type="button" aria-label="Jeda putar otomatis" data-rail-toggle data-state="playing">
        <Icon name="pause" class="icon icon--pause" />
        <Icon name="play" class="icon icon--play" />
      </button>
      <button class="rail__btn" type="button" aria-label="Testimoni sebelumnya" data-rail-prev>
        <Icon name="back" />
      </button>
      <button class="rail__btn" type="button" aria-label="Testimoni berikutnya" data-rail-next>
        <Icon name="arrow" />
      </button>
    </div>
  </header>

  <!-- Story-style cards drawn in HTML/CSS; the text is illustrative. -->
  <ul class="testi__track rail__track" role="list" aria-label={`${total} testimoni`} data-rail-track>
    {
      testimonials.map((t, i) => (
        <li>
          <figure class:list={['phone', `tone-${t.tone}`]}>
            <span class="phone__screen">
              <span class="story">
                <span class="story__bars" aria-hidden="true">
                  {[0, 1, 2].map((b) => (
                    <span class:list={['story__bar', { 'is-done': b < i % 3, 'is-now': b === i % 3 }]}>
                      <span />
                    </span>
                  ))}
                </span>

                <span class="story__head">
                  <span class="story__avatar" aria-hidden="true">{initials(t.name)}</span>
                  <span class="story__who">
                    <span class="story__name">{t.name}</span>
                    <span class="story__detail">{t.detail}</span>
                  </span>
                </span>

                <span class="story__sticker" aria-hidden="true">{t.topic}</span>

                <blockquote class="story__quote">
                  <p>{t.quote}</p>
                </blockquote>

                <span class="story__reply" aria-hidden="true">
                  <span>Kirim pesan</span>
                  <Icon name="arrow" />
                </span>
              </span>
            </span>
            <figcaption class="sr-only">
              {t.name}, {t.detail}, tentang {t.topic}
            </figcaption>
          </figure>
        </li>
      ))
    }
  </ul>

  <div class="rail__foot wrap">
    <p class="rail__hint">Contoh testimoni untuk pratinjau desain.</p>
    <span class="rail__bar" aria-hidden="true"><span data-rail-bar></span></span>
  </div>
</section>

<style>
  .testi {
    position: relative;
    padding-block: var(--section);
    background: var(--night);
    overflow: clip;
  }

  .testi__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 2rem;
    margin-bottom: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  .testi__title {
    margin-top: 1.25rem;
    font-size: clamp(2.5rem, 1.5rem + 3.8vw, 5.25rem);
    max-width: 22ch;
  }

  .testi__track {
    --rail-gap: clamp(0.75rem, 0.5rem + 0.8vw, 1.25rem);
    padding-block: 0.75rem;
  }

  .phone {
    display: block;
    width: clamp(11.5rem, 9rem + 7vw, 15rem);
  }

  .tone-sun {
    --st-bg: var(--sun);
    --st-fg: var(--ink);
    --st-accent: var(--ink);
    --st-on-accent: var(--sun);
  }

  .tone-night {
    --st-bg: radial-gradient(120% 80% at 20% 0%, var(--navy-3), var(--night) 70%);
    --st-fg: var(--cream);
    --st-accent: var(--sun);
    --st-on-accent: var(--ink);
  }

  .tone-cream {
    --st-bg: var(--cream);
    --st-fg: var(--ink);
    --st-accent: var(--sun);
    --st-on-accent: var(--ink);
  }

  .tone-navy {
    --st-bg: linear-gradient(170deg, var(--navy-3), var(--navy) 60%);
    --st-fg: var(--cream);
    --st-accent: var(--sun);
    --st-on-accent: var(--ink);
  }

  .phone__screen {
    position: relative;
    display: block;
    padding: 0.35rem;
    border-radius: 1.6rem;
    background: linear-gradient(160deg, #2a3150, #0b0f1e 60%);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.1),
      0 24px 48px -24px rgb(0 0 0 / 0.8);
    transition: transform 0.6s var(--ease);
  }

  .phone:hover .phone__screen {
    transform: translateY(-0.4rem) rotate(-1deg);
  }

  /* ─── Story ─── */
  .story {
    display: grid;
    grid-template-rows: auto auto 1fr auto auto;
    gap: 0.9rem;
    aspect-ratio: 9 / 16;
    padding: 0.85rem 0.9rem 0.9rem;
    border-radius: 1.3rem;
    background: var(--st-bg);
    color: var(--st-fg);
    overflow: hidden;
  }

  .story__bars {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.25rem;
  }

  .story__bar {
    height: 2px;
    border-radius: 2px;
    background: color-mix(in srgb, currentColor 30%, transparent);
    overflow: hidden;
  }

  .story__bar span {
    display: block;
    height: 100%;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
  }

  .story__bar.is-done span {
    transform: none;
  }

  .story__bar.is-now span {
    transform: scaleX(0.35);
  }

  /* Hovering plays the current segment, like a Story running. */
  .phone:hover .story__bar.is-now span {
    animation: story-run 3.2s linear forwards;
  }

  @keyframes story-run {
    from {
      transform: scaleX(0.35);
    }
    to {
      transform: scaleX(1);
    }
  }

  .story__head {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    min-width: 0;
  }

  .story__avatar {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 50%;
    background: var(--st-accent);
    color: var(--st-on-accent);
    box-shadow: 0 0 0 2px var(--st-on-accent), 0 0 0 3.5px var(--st-accent);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .story__who {
    display: grid;
    min-width: 0;
    line-height: 1.2;
  }

  .story__name {
    font-size: 0.8125rem;
    font-weight: 650;
  }

  .story__detail {
    font-size: 0.6875rem;
    opacity: 0.7;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .story__sticker {
    justify-self: start;
    align-self: end;
    padding: 0.35rem 0.7rem;
    border-radius: 0.5rem;
    background: var(--st-accent);
    color: var(--st-on-accent);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transform: rotate(-4deg);
    transition: transform 0.6s var(--ease);
  }

  .phone:hover .story__sticker {
    transform: rotate(3deg) scale(1.06);
  }

  .story__quote p {
    font-family: var(--f-display);
    font-stretch: 80%;
    font-weight: 650;
    font-size: clamp(1.05rem, 0.9rem + 0.45vw, 1.3rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }

  .story__quote p::before {
    content: '“';
    display: block;
    height: 0.55em;
    font-size: 2.6em;
    line-height: 0.9;
    color: var(--st-accent);
  }

  .story__reply {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.55rem 0.8rem;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, currentColor 35%, transparent);
    font-size: 0.75rem;
    opacity: 0.8;
  }

  .story__reply .icon {
    width: 0.9rem;
    height: 0.9rem;
  }

  /* Pause / play swap */
  [data-rail-toggle] :global(.icon--play),
  [data-rail-toggle][data-state='paused'] :global(.icon--pause) {
    display: none;
  }

  [data-rail-toggle][data-state='paused'] :global(.icon--play) {
    display: block;
  }
</style>
