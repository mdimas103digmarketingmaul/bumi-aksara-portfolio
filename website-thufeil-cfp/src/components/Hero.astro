---
import { Image } from 'astro:assets';
import portrait from '../assets/profile/thufeil-portrait.png';
import { bookingAnchor } from '../config/site';
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="container hero__grid">
    <div class="hero__copy">
      <h1 class="hero__title" id="hero-title">
        <span class="hero__name">
          <span class="hero__line"><span>Thufeil M.</span></span>
          <span class="hero__line"><span>Tyansah, CFP<sup class="reg">®</sup></span></span>
        </span>
        <span class="hero__role">Gen-Z Financial Planner</span>
      </h1>

      <p class="hero__lead">
        Perencana keuangan syariah dan teman diskusi soal gaji, cicilan, investasi, sampai zakat. Tanpa judging, dengan
        langkah yang realistis.
      </p>

      <div class="hero__actions">
        <a class="btn btn--primary" href={bookingAnchor}>Konsultasi Gratis 30 Menit</a>
        <a class="text-link" href="#keahlian">Lihat keahlian</a>
      </div>
    </div>

    <figure class="hero__figure">
      <div class="hero__frame">
        <div class="hero__panel" aria-hidden="true"></div>
        <Image
          class="hero__portrait"
          src={portrait}
          widths={[420, 640, 858]}
          sizes="(min-width: 64rem) 36rem, (min-width: 48rem) 40vw, (min-width: 40rem) 36rem, 92vw"
          format="webp"
          quality={86}
          loading="eager"
          fetchpriority="high"
          alt="Thufeil M. Tyansah tersenyum dengan tangan bersilang, mengenakan kacamata dan jaket varsity navy."
        />
      </div>
      <figcaption class="hero__caption">
        <span>Thufeil Muhammad Tyansah</span>
        <span>S.E., CFP®, AWPs®</span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    padding-top: calc(var(--nav-h) + clamp(1.5rem, 0.75rem + 3vw, 3.5rem));
    padding-bottom: clamp(3.5rem, 2rem + 5vw, 6.5rem);
  }

  .hero__grid {
    display: grid;
    gap: clamp(2.5rem, 2rem + 3vw, 4rem);
    align-items: end;
  }

  /* Tablet: its own two-column composition with a smaller type scale. */
  @media (min-width: 48rem) and (max-width: 63.99rem) {
    .hero__grid {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.85fr);
      gap: 2rem;
    }

    .hero__name {
      font-size: clamp(3.5rem, 1rem + 5.4vw, 4.4rem);
    }

    .hero__role {
      font-size: 1.85rem;
    }

    .hero__copy {
      padding-bottom: 2.75rem;
    }

    .hero__figure {
      justify-self: end;
    }

    .hero .hero__caption {
      flex-direction: column;
      gap: 0.15rem;
    }
  }

  @media (min-width: 64rem) {
    .hero__grid {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5.5fr);
      gap: clamp(2rem, 4vw, 5rem);
    }

    .hero__copy {
      padding-bottom: 4.5rem;
    }
  }

  .hero__title {
    display: grid;
    gap: clamp(0.6rem, 0.4rem + 0.8vw, 1.1rem);
  }

  .hero__name {
    display: block;
    font-family: var(--font-display);
    font-size: var(--fs-display);
    line-height: 0.96;
    letter-spacing: -0.02em;
  }

  .hero__line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
  }

  .hero__line > span {
    display: inline-block;
  }

  .hero__role {
    display: block;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.625rem, 1.15rem + 1.9vw, 2.75rem);
    line-height: 1.1;
    color: var(--green);
  }

  .hero__lead {
    margin-top: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
    max-width: 31rem;
    font-size: var(--fs-lead);
    line-height: 1.55;
    color: var(--ink-2);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: clamp(1.75rem, 1.25rem + 1.5vw, 2.5rem);
  }

  /* Portrait: transparent cut-out that breaks out of the top of a
     green panel. The full image is always shown, so the face is never cropped. */
  .hero__figure {
    position: relative;
    width: min(100%, 36rem);
    justify-self: center;
  }

  @media (min-width: 64rem) {
    .hero__figure {
      justify-self: end;
    }
  }

  .hero__frame {
    position: relative;
  }

  .hero__panel {
    position: absolute;
    inset: 22% 5% 0;
    background: var(--green);
    transform-origin: bottom;
  }

  .hero__portrait {
    position: relative;
    width: 100%;
    height: auto;
  }

  .hero__caption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-inline: 5%;
    padding-top: 0.85rem;
    border-top: 1px solid var(--line-strong);
    font-size: var(--fs-caption);
    color: var(--ink-3);
    letter-spacing: 0.01em;
  }

  .hero__caption span:first-child {
    color: var(--ink);
    font-weight: 600;
  }

  @media (max-width: 22.5rem) {
    .hero__caption {
      flex-direction: column;
      gap: 0.15rem;
    }
  }

  @media (max-width: 47.99rem) {
    .hero__actions .btn {
      flex: 1 1 100%;
    }

    .hero__actions {
      gap: 1.1rem;
    }
  }

  @media (min-width: 30rem) and (max-width: 47.99rem) {
    .hero__actions .btn {
      flex: 0 1 auto;
    }
  }

  /* ─── Load-in motion ─── */
  @media (prefers-reduced-motion: no-preference) {
    .hero__line > span {
      animation: rise 1s var(--ease-out) both;
    }

    .hero__line:nth-child(2) > span {
      animation-delay: 90ms;
    }

    .hero__role,
    .hero__lead,
    .hero__actions {
      animation: fade-up 0.9s var(--ease-out) both;
    }

    .hero__role {
      animation-delay: 260ms;
    }

    .hero__lead {
      animation-delay: 360ms;
    }

    .hero__actions {
      animation-delay: 440ms;
    }

    .hero__panel {
      animation: panel 1.1s var(--ease-out) 120ms both;
    }

    .hero__portrait {
      animation: fade-up 1.1s var(--ease-out) 260ms both;
    }

    .hero__caption {
      animation: fade-up 0.9s var(--ease-out) 520ms both;
    }
  }

  @keyframes rise {
    from {
      transform: translateY(105%);
    }
  }

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }

  @keyframes panel {
    from {
      transform: scaleY(0.82);
      opacity: 0;
    }
  }
</style>
