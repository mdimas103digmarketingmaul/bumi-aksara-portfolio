---
import BookingPanel from './BookingPanel.astro';
import { booking, isBookingLive } from '../config/site';

// Step one describes whatever scheduling actually works right now.
const steps = [
  {
    title: 'Atur jadwal',
    body: isBookingLive
      ? 'Pilih waktu yang kosong langsung di kalender.'
      : 'Hubungi lewat kanal yang paling nyaman buatmu, lalu kita sepakati waktunya.',
  },
  {
    title: 'Ceritakan kondisimu',
    body: 'Gambaran singkat soal penghasilan, pengeluaran, utang, atau tujuan yang sedang kamu pikirkan. Tidak perlu rapi.',
  },
  {
    title: `Ngobrol ${booking.durationMinutes} menit`,
    body: 'Lewat video call. Kita petakan kondisimu dan tentukan apa yang sebaiknya dikerjakan lebih dulu.',
  },
];
---

<section class:list={['section consult', { 'consult--live': isBookingLive }]} id="konsultasi" aria-labelledby="consult-title">
  <div class="container consult__grid">
    <div class="consult__copy" data-reveal>
      <span class="eyebrow">Konsultasi gratis</span>
      <h2 class="h2 consult__title" id="consult-title">Mulai dari {booking.durationMinutes} menit <em>ngobrol</em>.</h2>
      <p class="consult__lead">
        Gratis dan online. Bawa pertanyaanmu, serapi atau seberantakan apa pun kondisi keuanganmu sekarang.
      </p>

      <ol class="steps" role="list">
        {
          steps.map((step, i) => (
            <li class="step">
              <span class="step__num" aria-hidden="true">{i + 1}</span>
              <div>
                <h3 class="step__title">{step.title}</h3>
                <p class="step__body">{step.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="consult__panel" data-reveal style="--reveal-delay: 120ms">
      <BookingPanel />
    </div>
  </div>
</section>

<style>
  .consult {
    background: var(--mustard);
    color: var(--ink);
  }

  .consult .eyebrow {
    color: var(--ink);
  }

  .consult__grid {
    display: grid;
    gap: clamp(2.5rem, 2rem + 3vw, 4rem);
  }

  @media (min-width: 60rem) {
    .consult:not(.consult--live) .consult__grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4.5fr);
      gap: clamp(3rem, 6vw, 6.5rem);
      align-items: end;
    }
  }

  .consult__copy {
    display: grid;
    gap: 1rem;
  }

  .consult__title {
    font-size: clamp(2.6rem, 1.6rem + 4.2vw, 5.25rem);
    line-height: 0.96;
  }

  .consult__lead {
    max-width: 30rem;
    font-size: var(--fs-lead);
    line-height: 1.5;
  }

  .steps {
    margin-top: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border-top: 1px solid rgb(20 24 43 / 0.35);
  }

  @media (min-width: 48rem) {
    .consult--live .steps,
    .steps {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.75rem;
      border-top: 0;
    }

    .step {
      border-top: 1px solid rgb(20 24 43 / 0.35);
      padding-top: 1rem;
    }
  }

  .step {
    display: grid;
    align-content: start;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: 0.75rem;
    padding-block: 1.1rem;
    border-bottom: 1px solid rgb(20 24 43 / 0.2);
  }

  @media (min-width: 48rem) {
    .step {
      grid-template-columns: 1fr;
      border-bottom: 0;
      padding-bottom: 0;
      gap: 0.6rem;
    }
  }

  .step__num {
    font-family: var(--font-display);
    font-size: 1.75rem;
    line-height: 1;
  }

  .step__title {
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .step__body {
    margin-top: 0.3rem;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: rgb(20 24 43 / 0.82);
  }
</style>
