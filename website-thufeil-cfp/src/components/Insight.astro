---
import { Image } from 'astro:assets';
import Button from './Button.astro';
import Icon from './Icon.astro';
import { insightPosts } from '../data/content';
import { contact } from '../config/profile';
---

<section class="ins on-light" id="insight" aria-labelledby="ins-title" data-rail>
  <header class="ins__head wrap">
    <div>
      <p class="label" data-reveal>Insight</p>
      <h2 class="ins__title display" id="ins-title" data-split>Belajar finansial di {contact.instagramHandle}</h2>
    </div>
    <div data-reveal>
      <Button label={`Instagram ${contact.instagramHandle}`} icon="instagram" variant="ghost" />
    </div>
  </header>

  <!-- Placeholder posts: generated photos and slides drawn in CSS. Not linked yet. -->
  <ol class="ins__track rail__track" role="list" aria-label="Contoh konten edukasi" data-rail-track>
    {
      insightPosts.map((post, i) => (
        <li class="post" data-reveal>
          <article class="post__card">
            {post.image ? (
              <span class="post__media post__media--photo">
                <Image
                  src={post.image}
                  widths={[280, 420, 560]}
                  sizes="(min-width: 64rem) 18rem, 14rem"
                  format="webp"
                  quality={80}
                  loading="lazy"
                  alt={post.imageAlt ?? ''}
                />
                <span class="post__chip">{post.kind}</span>
                <span class="post__overlay display" aria-hidden="true">{post.headline}</span>
              </span>
            ) : (
              <span class:list={['post__media post__media--slide', `tone-${post.tone ?? 'sun'}`]} aria-hidden="true">
                <span class="slide__top">
                  <span class="slide__avatar">{contact.instagramHandle.charAt(1).toUpperCase()}</span>
                  {contact.instagramHandle}
                </span>
                <span class="slide__headline display">{post.headline}</span>
                <span class="slide__foot">
                  <span class="slide__dots">
                    {Array.from({ length: post.slides ?? 5 }, (_, d) => (
                      <span class:list={['slide__dot', { 'is-on': d === 0 }]} />
                    ))}
                  </span>
                  <span class="slide__swipe">
                    Geser <Icon name="arrow" />
                  </span>
                </span>
              </span>
            )}
            <span class="post__meta">
              <span class="post__num">{String(i + 1).padStart(2, '0')}</span>
              <span>{post.kind}</span>
            </span>
            <h3 class="post__title">{post.title}</h3>
          </article>
        </li>
      ))
    }
  </ol>

  <div class="rail__foot wrap">
    <p class="rail__hint">Geser untuk lihat insight lainnya.</p>
    <div class="rail__controls">
      <button class="rail__btn" type="button" aria-label="Postingan sebelumnya" data-rail-prev>
        <Icon name="back" />
      </button>
      <button class="rail__btn" type="button" aria-label="Postingan berikutnya" data-rail-next>
        <Icon name="arrow" />
      </button>
    </div>
  </div>
</section>

<style>
  .ins {
    position: relative;
    z-index: 2;
    padding-block: var(--section);
    border-radius: var(--r-lg) var(--r-lg) 0 0;
    margin-top: calc(var(--r-lg) * -1);
  }

  .ins__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 2rem;
    margin-bottom: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  .ins__title {
    margin-top: 1.25rem;
    font-size: clamp(2.5rem, 1.5rem + 3.8vw, 5.25rem);
    max-width: 20ch;
  }

  .ins__track {
    padding-block: 0.25rem;
  }

  .post {
    width: clamp(13rem, 10rem + 8vw, 18rem);
  }

  .post__card {
    display: grid;
    gap: 0.7rem;
  }

  .post__media {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    border-radius: var(--r-md);
    overflow: hidden;
    background: var(--cream-2);
    transition: transform 0.6s var(--ease);
  }

  .post__card:hover .post__media {
    transform: translateY(-0.3rem);
  }

  /* ─── Photo posts ─── */
  .post__media--photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.1s var(--ease);
  }

  .post__card:hover .post__media--photo :global(img) {
    transform: scale(1.06);
  }

  .post__media--photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(8 12 26 / 0.88), rgb(8 12 26 / 0.15) 55%, transparent);
  }

  .post__chip {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 1;
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
    background: var(--sun);
    color: var(--ink);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .post__overlay {
    position: absolute;
    inset: auto 1rem 1rem;
    z-index: 1;
    font-size: clamp(1.6rem, 1.2rem + 1vw, 2.1rem);
    line-height: 0.92;
    color: var(--cream);
    text-wrap: balance;
  }

  /* ─── Slide posts (carousel covers drawn in CSS) ─── */
  .post__media--slide {
    display: grid;
    grid-template-rows: auto 1fr auto;
    padding: 1.1rem;
    background: var(--slide-bg);
    color: var(--slide-fg);
  }

  .tone-sun {
    --slide-bg: var(--sun);
    --slide-fg: var(--ink);
    --slide-accent: var(--ink);
    --slide-on-accent: var(--sun);
  }

  .tone-night {
    --slide-bg: var(--night);
    --slide-fg: var(--cream);
    --slide-accent: var(--sun);
    --slide-on-accent: var(--ink);
  }

  .tone-cream {
    --slide-bg: #fffdf8;
    --slide-fg: var(--ink);
    --slide-accent: var(--sun);
    --slide-on-accent: var(--ink);
    box-shadow: inset 0 0 0 1px var(--line-l);
  }

  .tone-navy {
    --slide-bg: var(--navy);
    --slide-fg: var(--cream);
    --slide-accent: var(--sun);
    --slide-on-accent: var(--ink);
  }

  .slide__top {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 550;
  }

  .slide__avatar {
    display: grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    background: var(--slide-accent);
    color: var(--slide-on-accent);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .slide__headline {
    align-self: center;
    font-size: clamp(2rem, 1.5rem + 1.4vw, 2.75rem);
    line-height: 0.9;
    text-wrap: balance;
  }

  .slide__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .slide__dots {
    display: flex;
    gap: 0.3rem;
  }

  .slide__dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 999px;
    background: currentColor;
    opacity: 0.3;
    transition:
      width 0.5s var(--ease),
      opacity 0.5s var(--ease);
  }

  .slide__dot.is-on {
    width: 1.1rem;
    opacity: 1;
    background: var(--slide-accent);
  }

  .slide__swipe {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .slide__swipe .icon {
    width: 0.9rem;
    height: 0.9rem;
    transition: transform 0.5s var(--ease);
  }

  .post__card:hover .slide__swipe .icon {
    transform: translateX(0.3rem);
  }

  .post__card:hover .slide__dot:nth-child(2) {
    width: 1.1rem;
    opacity: 0.6;
  }

  /* ─── Caption ─── */
  .post__meta {
    display: flex;
    gap: 0.6rem;
    font-size: var(--t-label);
    font-weight: 550;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .post__num {
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .post__title {
    font-size: 0.9375rem;
    font-weight: 550;
    line-height: 1.35;
  }
</style>
