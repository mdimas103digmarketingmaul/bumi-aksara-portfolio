---
import { Image } from 'astro:assets';
import Button from './Button.astro';
import Icon from './Icon.astro';
import { instagramPosts } from '../data/content';
import { links } from '../config/site';
---

<section class="ins on-light" id="insight" aria-labelledby="ins-title" data-rail>
  <header class="ins__head wrap">
    <div>
      <p class="label" data-reveal>Insight</p>
      <h2 class="ins__title display" id="ins-title" data-split>Belajar finansial di {links.instagramHandle}</h2>
    </div>
    <div data-reveal>
      <Button href={links.instagram} label="Buka Instagram" icon="instagram" variant="ghost" arrow={false} external />
    </div>
  </header>

  <ol class="ins__track rail__track" role="list" aria-label="Postingan Instagram" data-rail-track>
    {
      instagramPosts.map((post, i) => (
        <li class="post" data-reveal>
          <a class="post__link" href={links.instagram} target="_blank" rel="noopener noreferrer">
            <span class="post__media">
              <Image
                src={post.image}
                widths={[280, 420, 560]}
                sizes="(min-width: 64rem) 18rem, 14rem"
                format="webp"
                quality={80}
                loading="lazy"
                alt={post.alt}
              />
              <span class="post__go" aria-hidden="true">
                <Icon name="external" />
              </span>
            </span>
            <span class="post__meta">
              <span class="post__num">{String(i + 1).padStart(2, '0')}</span>
              <span>{post.kind}</span>
            </span>
            <span class="post__title">{post.title}</span>
            <span class="sr-only">— buka Instagram (tab baru)</span>
          </a>
        </li>
      ))
    }
  </ol>

  <div class="rail__foot wrap">
    <p class="rail__hint">Geser untuk lihat insight lainnya.</p>
    <div class="rail__controls">
      <button class="rail__btn" type="button" aria-label="Postingan sebelumnya" data-rail-prev>
        <Icon name="back" />
      </button>
      <button class="rail__btn" type="button" aria-label="Postingan berikutnya" data-rail-next>
        <Icon name="arrow" />
      </button>
    </div>
  </div>
</section>

<style>
  .ins {
    position: relative;
    z-index: 2;
    padding-block: var(--section);
    border-radius: var(--r-lg) var(--r-lg) 0 0;
    margin-top: calc(var(--r-lg) * -1);
  }

  .ins__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 2rem;
    margin-bottom: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  .ins__title {
    margin-top: 1.25rem;
    font-size: clamp(2.5rem, 1.5rem + 3.8vw, 5.25rem);
    max-width: 20ch;
  }

  .ins__track {
    padding-block: 0.25rem;
  }

  .post {
    width: clamp(13rem, 10rem + 8vw, 18rem);
  }

  .post__link {
    display: grid;
    gap: 0.7rem;
    text-decoration: none;
  }

  .post__media {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    border-radius: var(--r-md);
    overflow: hidden;
    background: var(--cream-2);
  }

  .post__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.1s var(--ease);
  }

  .post__link:hover .post__media :global(img) {
    transform: scale(1.06);
  }

  .post__go {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--sun);
    color: var(--ink);
    transform: scale(0.4);
    opacity: 0;
    transition:
      transform 0.6s var(--ease),
      opacity 0.4s var(--ease);
  }

  .post__link:hover .post__go,
  .post__link:focus-visible .post__go {
    transform: none;
    opacity: 1;
  }

  .post__meta {
    display: flex;
    gap: 0.6rem;
    font-size: var(--t-label);
    font-weight: 550;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .post__num {
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .post__title {
    font-size: 0.9375rem;
    font-weight: 550;
    line-height: 1.35;
  }
</style>
