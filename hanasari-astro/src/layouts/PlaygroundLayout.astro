---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Playground visual Hanasari Catering untuk membandingkan alternatif desain homepage.'
} = Astro.props;
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex,nofollow,noarchive" />
    <meta name="theme-color" content="#0f2827" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
  </head>
  <body class="playground-body">
    <slot />
  </body>
</html>

<style is:global>
  .playground-body {
    margin: 0;
    min-height: 100vh;
    background: #f4f1ea;
    color: #173a38;
  }
</style>
