---
/*
 * Hanasari Catering — Visual Option 1 (playground)
 * Route: /playground/option-1/  (noindex — lihat Option1Layout)
 * Semua file pendukung terisolasi di:
 *   src/components/playground/option-1/
 *   src/styles/playground/option-1.css
 *   public/assets/playground/option-1/
 * Artikel hanya DIBACA dari content collection yang sama dengan production.
 */
import { getCollection } from 'astro:content';
import Option1Layout from '../../../components/playground/option-1/Option1Layout.astro';
import PlaygroundBar from '../../../components/playground/option-1/PlaygroundBar.astro';
import SiteHeader from '../../../components/playground/option-1/SiteHeader.astro';
import Hero from '../../../components/playground/option-1/Hero.astro';
import TrustStrip from '../../../components/playground/option-1/TrustStrip.astro';
import MenuSection from '../../../components/playground/option-1/MenuSection.astro';
import DishExplorer from '../../../components/playground/option-1/DishExplorer.astro';
import AboutSection from '../../../components/playground/option-1/AboutSection.astro';
import HowToOrder from '../../../components/playground/option-1/HowToOrder.astro';
import Testimonials from '../../../components/playground/option-1/Testimonials.astro';
import FeaturedArticles from '../../../components/playground/option-1/FeaturedArticles.astro';
import OrderChannels from '../../../components/playground/option-1/OrderChannels.astro';
import Consultation from '../../../components/playground/option-1/Consultation.astro';
import Faq from '../../../components/playground/option-1/Faq.astro';
import SiteFooter from '../../../components/playground/option-1/SiteFooter.astro';

const featuredArticles = (await getCollection('articles'))
  .filter(({ data }) => data.status === 'published' && data.featured)
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3)
  .map(({ data }) => data);
---
<Option1Layout title="Hanasari Catering — Visual Option 1">
  <PlaygroundBar />
  <SiteHeader />
  <main id="utama">
    <Hero />
    <TrustStrip />
    <MenuSection />
    <DishExplorer />
    <AboutSection />
    <HowToOrder />
    <Testimonials />
    <FeaturedArticles articles={featuredArticles} />
    <OrderChannels />
    <Consultation />
    <Faq />
  </main>
  <SiteFooter />
</Option1Layout>
