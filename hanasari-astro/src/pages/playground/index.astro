---
import PlaygroundLayout from '../../layouts/PlaygroundLayout.astro';

const options = [
  { number: 1, status: 'Siap diisi' },
  { number: 2, status: 'Siap diisi' },
  { number: 3, status: 'Siap diisi' },
  { number: 4, status: 'Siap diisi' }
];
---
<PlaygroundLayout title="Hanasari Catering — Visual Playground">
  <main class="playground-index">
    <header class="playground-header">
      <div>
        <p class="eyebrow">HANASARI CATERING / DESIGN PLAYGROUND</p>
        <h1>Homepage<br />Visual Options</h1>
      </div>
      <div class="playground-header__actions">
        <p>Area eksperimen untuk membandingkan empat alternatif visual tanpa mengubah homepage production.</p>
        <a href="/" target="_blank" rel="noreferrer">Buka Production ↗</a>
      </div>
    </header>

    <section class="option-grid" aria-label="Daftar opsi visual">
      {options.map(({ number, status }) => (
        <a class="option-card" href={`/playground/option-${number}/`}>
          <div class="option-card__top">
            <span>OPTION</span>
            <strong>0{number}</strong>
          </div>
          <div class="option-card__preview">
            <span>Preview area</span>
          </div>
          <div class="option-card__bottom">
            <div>
              <h2>Visual Option {number}</h2>
              <p>{status}</p>
            </div>
            <span class="arrow">↗</span>
          </div>
        </a>
      ))}
    </section>

    <footer class="playground-note">
      <strong>Catatan:</strong>
      <span>Halaman playground diberi <code>noindex</code>, sehingga aman untuk preview publik tanpa ditujukan masuk indeks mesin pencari.</span>
    </footer>
  </main>
</PlaygroundLayout>

<style>
  .playground-index {
    width: min(1440px, 100%);
    margin: 0 auto;
    padding: clamp(28px, 5vw, 72px);
  }

  .playground-header {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    gap: clamp(32px, 7vw, 120px);
    align-items: end;
    margin-bottom: clamp(42px, 7vw, 90px);
  }

  .eyebrow {
    margin: 0 0 18px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.16em;
  }

  h1 {
    margin: 0;
    font-size: clamp(52px, 8vw, 112px);
    line-height: 0.87;
    letter-spacing: -0.055em;
  }

  .playground-header__actions p {
    margin: 0 0 24px;
    max-width: 520px;
    font-size: 17px;
    line-height: 1.65;
  }

  .playground-header__actions a {
    display: inline-flex;
    padding: 13px 18px;
    border: 1px solid #173a38;
    border-radius: 999px;
    color: #173a38;
    font-size: 13px;
    font-weight: 800;
    text-decoration: none;
  }

  .option-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .option-card {
    display: block;
    padding: 20px;
    border: 1px solid rgba(23, 58, 56, 0.16);
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.58);
    color: #173a38;
    text-decoration: none;
    transition: transform 180ms ease, box-shadow 180ms ease, background 180ms ease;
  }

  .option-card:hover {
    transform: translateY(-4px);
    background: #fff;
    box-shadow: 0 22px 60px rgba(23, 58, 56, 0.1);
  }

  .option-card__top,
  .option-card__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .option-card__top span,
  .option-card__top strong {
    font-size: 11px;
    letter-spacing: 0.14em;
  }

  .option-card__preview {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 8.7;
    margin: 18px 0 20px;
    border-radius: 16px;
    background: #173a38;
    color: rgba(255, 255, 255, 0.45);
  }

  .option-card__preview span {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .option-card h2,
  .option-card p {
    margin: 0;
  }

  .option-card h2 {
    font-size: clamp(20px, 2.5vw, 31px);
    letter-spacing: -0.03em;
  }

  .option-card p {
    margin-top: 5px;
    font-size: 13px;
    opacity: 0.6;
  }

  .arrow {
    font-size: 26px;
  }

  .playground-note {
    display: flex;
    gap: 8px;
    margin-top: 28px;
    padding-top: 22px;
    border-top: 1px solid rgba(23, 58, 56, 0.14);
    font-size: 12px;
    line-height: 1.55;
  }

  @media (max-width: 800px) {
    .playground-header,
    .option-grid {
      grid-template-columns: 1fr;
    }

    .playground-header {
      gap: 28px;
    }

    .playground-note {
      flex-direction: column;
    }
  }
</style>
