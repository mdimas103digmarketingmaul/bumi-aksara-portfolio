---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ArticleCard from '../../components/ArticleCard.astro';
const articles = (await getCollection('articles')).filter(({ data }) => data.status === 'published').sort((a,b)=>b.data.publishDate.getTime()-a.data.publishDate.getTime());
---
<BaseLayout title="Artikel — Hanasari Catering" description="Kumpulan promo, resep, dan inspirasi dari Hanasari Catering.">
  <Header articleMode />
  <main id="utama">
    <section class="article-page-hero"><div class="container article-page-hero-grid"><div><div class="eyebrow">DARI DAPUR HANASARI</div><h1>Artikel, resep, dan<br /><span class="hero-highlight">promo terbaru.</span></h1></div><div><p>Temukan inspirasi sajian, resep sederhana, dan informasi promo Hanasari dalam satu tempat.</p><span class="article-count">{articles.length} artikel</span></div></div></section>
    <section class="section article-list-section"><div class="container"><div class="article-toolbar" role="group" aria-label="Filter kategori artikel"><button class="article-filter active" data-category="Semua" aria-pressed="true">Semua</button><button class="article-filter" data-category="Promo" aria-pressed="false">Promo</button><button class="article-filter" data-category="Resep" aria-pressed="false">Resep</button><button class="article-filter" data-category="Tips & Inspirasi" aria-pressed="false">Tips & Inspirasi</button></div><div class="article-grid article-grid-all" id="article-list">{articles.map(({data}) => <ArticleCard article={data} />)}</div><p class="article-empty" id="article-empty" hidden>Belum ada artikel pada kategori ini.</p></div></section>
    <section class="article-cta"><div class="container article-cta-inner"><div><div class="eyebrow">BUTUH BANTUAN MEMILIH MENU?</div><h2>Ceritakan kebutuhan<br /><em>acara Anda.</em></h2></div><a class="button button-light" href="https://wa.me/628563050300">Chat WhatsApp <span aria-hidden="true">↗</span></a></div></section>
  </main>
  <Footer />
  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>('.article-filter');
    const cards = document.querySelectorAll<HTMLElement>('.article-card');
    const empty = document.querySelector<HTMLElement>('#article-empty');
    buttons.forEach((button) => button.addEventListener('click', () => {
      const category = button.dataset.category || 'Semua'; let shown = 0;
      buttons.forEach((item) => { const active = item === button; item.classList.toggle('active', active); item.setAttribute('aria-pressed', String(active)); });
      cards.forEach((card) => { const visible = category === 'Semua' || card.dataset.category === category; card.classList.toggle('is-hidden', !visible); if (visible) shown += 1; });
      if (empty) empty.hidden = shown > 0;
    }));
  </script>
</BaseLayout>
