---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ArticleCard from '../../components/ArticleCard.astro';
export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.filter(({data}) => data.status === 'published').map((article) => ({ params: { slug: article.data.slug }, props: { article } }));
}
const { article } = Astro.props;
const { Content } = await render(article);
const formattedDate = new Intl.DateTimeFormat('id-ID', { day:'numeric', month:'long', year:'numeric' }).format(article.data.publishDate);
const related = (await getCollection('articles')).filter(({data}) => data.status === 'published' && data.slug !== article.data.slug && data.category === article.data.category).sort((a,b)=>b.data.publishDate.getTime()-a.data.publishDate.getTime()).slice(0,3);
---
<BaseLayout title={article.data.seoTitle || `${article.data.title} — Hanasari Catering`} description={article.data.seoDescription || article.data.excerpt} image={article.data.thumbnail}>
  <Header articleMode />
  <main id="utama">
    <article class="article-detail">
      <div class="container article-detail-head"><a class="article-back" href="/artikel/">← Semua Artikel</a><div class="article-detail-meta"><span>{article.data.category}</span><time datetime={article.data.publishDate.toISOString()}>{formattedDate}</time></div><h1>{article.data.title}</h1><p>{article.data.excerpt}</p></div>
      <div class="container article-cover-wrap"><img class="article-cover" src={article.data.thumbnail} alt={article.data.thumbnailAlt} width="1200" height="900" /></div>
      <div class="container article-content-wrap"><div class="article-body prose"><Content /></div><aside class="article-side-cta"><span>HANASARI CATERING</span><strong>Butuh sajian untuk acara Anda?</strong><p>Ceritakan kebutuhan Anda, kami bantu memilih pilihan yang sesuai.</p><a class="button" href="https://wa.me/628563050300">Konsultasi via WhatsApp <span aria-hidden="true">↗</span></a></aside></div>
    </article>
    {related.length > 0 && <section class="section related-section"><div class="container"><div class="section-heading"><div><div class="eyebrow">LANJUT MEMBACA</div><h2>Artikel <em>terkait.</em></h2></div><a class="text-link" href="/artikel/">Lihat semua artikel <span aria-hidden="true">↗</span></a></div><div class="article-grid">{related.map(({data}) => <ArticleCard article={data} compact />)}</div></div></section>}
  </main>
  <Footer />
</BaseLayout>
