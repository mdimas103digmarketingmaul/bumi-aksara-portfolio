---
/*
 * Detail artikel — memakai layout, header, dan footer utama website; kepala artikel memakai
 * latar grid emas dan motion yang sama dengan hero homepage.
 * Konten tetap dari Content Collection `articles` (Markdown, dikelola lewat Decap CMS).
 */
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import SiteHeader from '../../components/site/SiteHeader.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
import ArticleCard from '../../components/site/ArticleCard.astro';
import Icon from '../../components/site/Icon.astro';
import { waLink } from '../../components/site/data';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles
    .filter(({ data }) => data.status === 'published')
    .map((article) => ({ params: { slug: article.data.slug }, props: { article } }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const formattedDate = new Intl.DateTimeFormat('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }).format(article.data.publishDate);
const related = (await getCollection('articles'))
  .filter(({ data }) => data.status === 'published' && data.slug !== article.data.slug && data.category === article.data.category)
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3);
---
<SiteLayout
  title={article.data.seoTitle || `${article.data.title} — Hanasari Catering`}
  description={article.data.seoDescription || article.data.excerpt}
  image={article.data.thumbnail}
  ogType="article"
>
  <SiteHeader onHome={false} current="artikel" />
  <main id="utama">
    <article class="o1-post">
      <header class="o1-post__head" data-float-anchor>
        <div class="o1-ahero__bg" aria-hidden="true">
          <svg class="o1-hero__grid" viewBox="0 0 400 400"><defs><pattern id="o1-post-grid" width="40" height="40" patternUnits="userSpaceOnUse" patternTransform="rotate(-38)"><path d="M0 0H40M0 0V40" stroke="currentColor" stroke-width="2.4" fill="none" /></pattern></defs><rect width="400" height="400" fill="url(#o1-post-grid)" /></svg>
        </div>
        <div class="o1-container o1-post__head-inner">
          <a class="o1-post__back" href="/artikel/"><Icon name="arrow-left" size={16} /> Semua artikel</a>
          <p class="o1-post__meta"><span>{article.data.category}</span><time datetime={article.data.publishDate.toISOString()}>{formattedDate}</time></p>
          <h1 class="o1-post__title">{article.data.title}</h1>
          <p class="o1-post__excerpt">{article.data.excerpt}</p>
        </div>
      </header>

      <div class="o1-container">
        <figure class="o1-post__cover">
          <img src={article.data.thumbnail} alt={article.data.thumbnailAlt} width="1200" height="900" fetchpriority="high" />
        </figure>

        <div class="o1-post__layout">
          <div class="o1-prose">
            <Content />
          </div>
          <aside class="o1-post__cta">
            <p class="o1-eyebrow">Hanasari Catering</p>
            <strong>Butuh sajian untuk acara Anda?</strong>
            <p>Ceritakan kebutuhan Anda, kami bantu memilih menu dan paket yang sesuai.</p>
            <a class="o1-btn o1-btn--primary o1-btn--block" href={waLink(`Saya membaca artikel "${article.data.title}" dan ingin konsultasi catering.`, 'Artikel')} target="_blank" rel="noopener noreferrer">
              <Icon name="whatsapp" /> Chat WhatsApp
            </a>
          </aside>
        </div>
      </div>
    </article>

    {related.length > 0 && (
      <section class="o1-section o1-articles o1-post__related" aria-labelledby="o1-related-title">
        <div class="o1-container">
          <div class="o1-heading">
            <div>
              <p class="o1-eyebrow">Lanjut membaca</p>
              <h2 id="o1-related-title" class="o1-h2">Artikel <em>terkait.</em></h2>
            </div>
            <div class="o1-heading__aside">
              <a class="o1-link" href="/artikel/">Lihat semua artikel <Icon name="arrow" size={18} /></a>
            </div>
          </div>
          <div class="o1-articles__grid o1-alist__grid">
            {related.map(({ data }, i) => <ArticleCard article={data} delay={i * 90} />)}
          </div>
        </div>
      </section>
    )}
  </main>
  <SiteFooter onHome={false} logo="badge" />
</SiteLayout>
