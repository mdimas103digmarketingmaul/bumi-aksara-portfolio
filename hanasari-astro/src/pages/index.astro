---
/*
 * Homepage Hanasari Catering.
 * Komponen: src/components/site/ · data konten: src/components/site/data.ts
 * Artikel pilihan dibaca dari Content Collection `articles` (featured: true).
 */
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import Hero from '../components/site/Hero.astro';
import TrustStrip from '../components/site/TrustStrip.astro';
import MenuSection from '../components/site/MenuSection.astro';
import DishExplorer from '../components/site/DishExplorer.astro';
import CustomOrder from '../components/site/CustomOrder.astro';
import AboutSection from '../components/site/AboutSection.astro';
import Testimonials from '../components/site/Testimonials.astro';
import FeaturedArticles from '../components/site/FeaturedArticles.astro';
import HowToOrder from '../components/site/HowToOrder.astro';
import Consultation from '../components/site/Consultation.astro';
import Faq from '../components/site/Faq.astro';
import SiteFooter from '../components/site/SiteFooter.astro';

const featuredArticles = (await getCollection('articles'))
  .filter(({ data }) => data.status === 'published' && data.featured)
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3)
  .map(({ data }) => data);
---
<SiteLayout
  title="Hanasari Catering — Harga Merakyat, Rasa Ningrat"
  description="Hidangan Nusantara untuk momen istimewa Anda. Pilih nasi box, snack box, tumpeng, nasi liwet, hingga hantaran Hanasari Catering di Jakarta Timur. Konsultasikan acara Anda melalui WhatsApp."
  preloadHero
>
  <SiteHeader />
  <main id="utama">
    <Hero />
    <TrustStrip />
    <MenuSection />
    <DishExplorer />
    <CustomOrder />
    <AboutSection />
    <Testimonials />
    <HowToOrder />
    <Consultation />
    <Faq />
    <FeaturedArticles articles={featuredArticles} />
  </main>
  <SiteFooter />
</SiteLayout>
