---
import Icon from './Icon.astro';
import TrustIcon from './TrustIcon.astro';
import { clients, img } from './data';

const features = [
  { icon: 'halal', title: 'Sajian halal' },
  { icon: 'nusantara', title: 'Ragam rasa Nusantara' },
  { icon: 'momen', title: 'Paket tiap momen' },
  { icon: 'menu', title: 'Bebas pilih menu', href: '#racik-isi-box' }
] as const;
---
<section id="keunggulan" class="o1-trust" aria-label="Keunggulan dan pelanggan Hanasari">
  <div class="o1-container">
    <ul class="o1-trust__features" data-reveal>
      {features.map((item) => (
        <li>
          {'href' in item ? (
            <a href={item.href} class="o1-trust__feature o1-trust__feature--link">
              <span class:list={['o1-trust__icon', `o1-trust__icon--${item.icon}`]}><TrustIcon name={item.icon} /></span>
              <strong>{item.title}</strong>
              <Icon name="arrow" size={16} class="o1-trust__arrow" />
            </a>
          ) : (
            <div class="o1-trust__feature">
              <span class:list={['o1-trust__icon', `o1-trust__icon--${item.icon}`]}><TrustIcon name={item.icon} /></span>
              <strong>{item.title}</strong>
            </div>
          )}
        </li>
      ))}
    </ul>

    <div class="o1-clients" data-reveal>
      <h2 class="o1-clients__title">Terima kasih atas <em>kepercayaan Anda:</em></h2>
      <div class="o1-marquee o1-clients__marquee" aria-label="Pelanggan Hanasari">
        <ul class="o1-marquee__track">
          {clients.map((name) => <li>{name}</li>)}
        </ul>
        <ul class="o1-marquee__track" aria-hidden="true">
          {clients.map((name) => <li>{name}</li>)}
        </ul>
      </div>
      <div class="o1-clients__badges">
        <img src={img('halal-indonesia.webp')} alt="Halal Indonesia" width="22" height="40" loading="lazy" />
        <img src={img('buatan-indonesia.webp')} alt="Bangga Buatan Indonesia" width="40" height="42" loading="lazy" />
        <img class="o1-clients__badge--wide" src={img('inaproc.webp')} alt="INAPROC Katalog Elektronik" width="104" height="29" loading="lazy" />
        <img class="o1-clients__badge--slhs" src={img('slhs.webp')} alt="SLHS — Sertifikat Laik Higiene Sanitasi, Kementerian Kesehatan RI" width="149" height="120" loading="lazy" />
      </div>
    </div>
  </div>
</section>
