---
/*
 * Tentang Hanasari: menceritakan orang di balik Hanasari.
 * Foto tim menjadi visual utama (srcset 960/1600), diikuti pita kesempatan.
 */
import { img } from './data';

const photo = img('tim-hanasari');
---
<section id="tentang-kami" class="o1-section o1-about" aria-labelledby="o1-about-title">
  <div class="o1-container">
    <div class="o1-about__copy" data-reveal>
      <div>
        <p class="o1-eyebrow">Tentang Hanasari</p>
        <h2 id="o1-about-title" class="o1-h2 o1-about__title"><span>Dari dapur kami,</span> <span>untuk <em>banyak momen.</em></span></h2>
      </div>
      <div class="o1-about__body">
        <p>PT Hanasari Asa Nusantara hadir dengan satu prinsip sederhana: menyajikan makanan yang enak, konsisten, dan tiba tepat waktu.</p>
        <p>Berbekal pengalaman melayani perusahaan, institusi, hingga berbagai acara, kami terus menjaga semangat <strong>“Harga Merakyat, Rasa Ningrat”</strong>—sajian berkualitas yang tetap terasa dekat dan dapat diandalkan.</p>
      </div>
    </div>

    <figure class="o1-about__photo" data-reveal>
      <img
        src={`${photo}-1600.webp`}
        srcset={`${photo}-960.webp 960w, ${photo}-1600.webp 1600w`}
        sizes="(max-width: 720px) 100vw, min(1240px, 92vw)"
        alt="Tim Hanasari Catering berfoto bersama di taman, mengenakan seragam bernuansa krem dan cokelat"
        width="1600" height="1067" loading="lazy" decoding="async"
      />
      <figcaption>Tim Hanasari</figcaption>
    </figure>
  </div>
</section>

<div class="o1-occasions" aria-label="Satu dapur, banyak cerita">
  <div class="o1-marquee o1-marquee--big">
    {[0, 1].map((n) => (
      <ul class="o1-marquee__track" aria-hidden={n === 1 ? 'true' : undefined}>
        <li>Rapat kantor</li><li class="is-star">✳</li>
        <li>Acara keluarga</li><li class="is-star">✳</li>
        <li>Syukuran</li><li class="is-star">✳</li>
        <li>Momen berbagi</li><li class="is-star">✳</li>
        <li>#RayakanDenganHanasari</li><li class="is-star">✳</li>
      </ul>
    ))}
  </div>
</div>
