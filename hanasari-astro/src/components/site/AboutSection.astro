---
import Icon from './Icon.astro';
import { img, waLink } from './data';

/* Sumber: Compro B2B Hanasari (Tentang Kami, Mengapa Memilih Kami) & Brand Guide (Brand Statement). */
const values = [
  { title: 'Halal & berkualitas', text: 'Diolah dari bahan terbaik dan halal, dengan rasa yang konsisten dari satu acara ke acara berikutnya.' },
  { title: 'Tepat waktu', text: 'Rapat, pelatihan, dan acara punya jadwal yang tak bisa menunggu. Ketepatan pengiriman jadi prioritas kami.' },
  { title: 'Menu fleksibel', text: 'Paket dan pilihan lauk bisa disesuaikan dengan kebutuhan Anda, dengan harga yang transparan.' },
  { title: 'Tumbuh bersama usaha lokal', text: 'Memilih Hanasari berarti ikut mendukung usaha lokal dan peluang ekonomi masyarakat.' }
];
---
<section id="tentang-kami" class="o1-section o1-about" aria-labelledby="o1-about-title">
  <div class="o1-container o1-about__grid">
    <div class="o1-about__visual" data-reveal>
      <figure class="o1-about__main">
        <img src={img('tumpeng.webp')} alt="Tumpeng Hanasari, nasi kuning dengan beragam lauk untuk dinikmati bersama" width="1050" height="1400" loading="lazy" decoding="async" />
      </figure>
      <div class="o1-about__stamp" aria-hidden="true">Dibuat untuk<strong>dinikmati bersama.</strong></div>
    </div>

    <div class="o1-about__copy">
      <div data-reveal>
        <p class="o1-eyebrow">Tentang Kami</p>
        <h2 id="o1-about-title" class="o1-h2">Bukan sekadar sajian. Bagian dari <em>kebersamaan.</em></h2>
        <p class="o1-about__lead">Hanasari Catering, di bawah PT Hanasari Asa Nusantara, menghadirkan hidangan selera Nusantara dengan kualitas premium dan harga yang bersahabat. <strong>Harga Merakyat, Rasa Ningrat.</strong></p>
        <p>Bagi kami, makanan adalah pengalaman kebersamaan. Karena itu setiap menu diolah dengan cita rasa terbaik dan disajikan dengan pelayanan yang profesional, dari makan siang kantor, rapat, dan pelatihan, hingga syukuran keluarga.</p>
      </div>
      <ol class="o1-values" data-reveal>
        {values.map((v, i) => (
          <li>
            <span class="o1-values__num">{String(i + 1).padStart(2, '0')}</span>
            <div><h3>{v.title}</h3><p>{v.text}</p></div>
          </li>
        ))}
      </ol>
      <a class="o1-link" href={waLink('Saya ingin berdiskusi tentang kebutuhan acara saya.', 'Tentang kami')} target="_blank" rel="noopener noreferrer" data-reveal>
        Mari ceritakan rencana acara Anda <Icon name="arrow" size={18} />
      </a>
    </div>
  </div>
</section>

<div class="o1-occasions" aria-label="Satu dapur, banyak cerita">
  <div class="o1-marquee o1-marquee--big">
    {[0, 1].map((n) => (
      <ul class="o1-marquee__track" aria-hidden={n === 1 ? 'true' : undefined}>
        <li>Rapat kantor</li><li class="is-star">✳</li>
        <li>Acara keluarga</li><li class="is-star">✳</li>
        <li>Syukuran</li><li class="is-star">✳</li>
        <li>Momen berbagi</li><li class="is-star">✳</li>
        <li>#RayakanDenganHanasari</li><li class="is-star">✳</li>
      </ul>
    ))}
  </div>
</div>
