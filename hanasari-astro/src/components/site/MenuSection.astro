---
import Icon from './Icon.astro';
import ProductCard from './ProductCard.astro';
import { categories, products, CATALOG_URL } from './data';

const groups = categories.map((cat) => {
  const list = products.filter((p) => p.category === cat.id);
  const prices = list.map((p) => p.price).filter((p): p is number => p !== null);
  return { ...cat, list, from: prices.length ? Math.min(...prices) : null };
});
---
<section id="menu" class="o1-section o1-menu" aria-labelledby="o1-menu-title">
  <div class="o1-container">
    <div class="o1-heading" data-reveal>
      <div>
        <p class="o1-eyebrow">Pilihan dari dapur kami</p>
        <h2 id="o1-menu-title" class="o1-h2">Ada sajian untuk <em>setiap kesempatan.</em></h2>
      </div>
      <div class="o1-heading__aside">
        <p>Dari nasi box kantor dan tumpeng syukuran, hingga hantaran dan kue kering. Pilih kategori untuk melihat pilihannya.</p>
        <a class="o1-link" href={CATALOG_URL} target="_blank" rel="noopener"><Icon name="doc" size={18} /> Unduh katalog lengkap (PDF)</a>
      </div>
    </div>

    <div class="o1-tabs" data-tabs>
      <div class="o1-cats" role="tablist" aria-label="Kategori menu" data-cats data-reveal>
        {groups.map((cat, i) => (
          <button class="o1-cat" role="tab" type="button" id={`o1-tab-${cat.id}`} aria-controls={`o1-panel-${cat.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-tab={cat.id}>
            <span class="o1-cat__thumb"><img src={cat.thumb} alt="" width="88" height="88" loading="lazy" decoding="async" /></span>
            <span class="o1-cat__text">
              <strong>{cat.label}</strong>
              <small>{cat.list.length} pilihan{cat.from && <> · mulai Rp{cat.from / 1000}rb</>}</small>
            </span>
          </button>
        ))}
      </div>

      {groups.map((cat, i) => (
        <div class:list={['o1-tabs__panel', { 'is-active': i === 0 }]} role="tabpanel" id={`o1-panel-${cat.id}`} aria-labelledby={`o1-tab-${cat.id}`} data-panel={cat.id}>
          <div class="o1-tabs__head">
            <div>
              <h3 class="o1-tabs__title">{cat.label}</h3>
              <p class="o1-tabs__intro">{cat.intro}</p>
            </div>
            <div class="o1-slider-nav">
              <button class="o1-round-btn" type="button" data-slide-prev aria-label={`${cat.label} sebelumnya`}><Icon name="arrow-left" /></button>
              <button class="o1-round-btn" type="button" data-slide-next aria-label={`${cat.label} berikutnya`}><Icon name="arrow-right" /></button>
            </div>
          </div>
          <ul class="o1-track" data-track tabindex="0" aria-label={`Pilihan ${cat.label}, geser untuk melihat lainnya`}>
            {cat.list.map((product, index) => <ProductCard product={product} index={index} categoryLabel={cat.label} />)}
          </ul>
          <div class="o1-track__progress" aria-hidden="true"><span data-progress></span></div>
        </div>
      ))}
    </div>

    <p class="o1-menu__note">
      Konfirmasikan harga, isi paket, dan ketersediaan kepada admin.
      <a href="#kebutuhan-khusus">Mencari sajian lain? Lihat kebutuhan khusus</a>
    </p>
  </div>
</section>
