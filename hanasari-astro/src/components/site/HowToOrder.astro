---
/*
 * Cara pesan — gabungan section "Gampang dari awal" (langkah) dan
 * "Dekat, lewat cara Anda" (kanal pemesanan) agar pesannya tidak berulang.
 */
import Icon from './Icon.astro';
import { LINKS_URL, asset, waLink } from './data';

/* Isi GOFOOD_URL / GRABFOOD_URL bila toko resmi sudah tersedia. Jika kosong, tombol meminta link ke admin. */
const GOFOOD_URL = '';
const GRABFOOD_URL = '';

const steps = [
  { icon: 'cart', title: 'Pilih sajian', text: 'Jelajahi paket dan racik isi box, atau ceritakan menu yang Anda inginkan.' },
  { icon: 'chat', title: 'Diskusikan kebutuhan', text: 'Sampaikan tanggal, jumlah porsi, anggaran, dan lokasi acara kepada admin.' },
  { icon: 'check', title: 'Konfirmasi & nikmati', text: 'Sepakati rincian pesanan, pembayaran, dan pengiriman bersama admin.' }
] as const;

const channels = [
  {
    key: 'gofood', title: 'GoFood', text: GOFOOD_URL ? 'Buka toko & pesan' : 'Minta link toko ke admin',
    href: GOFOOD_URL || waLink('Boleh minta link toko Hanasari di GoFood dan info ketersediaannya?', 'GoFood'), mark: 'G'
  },
  {
    key: 'grab', title: 'GrabFood', text: GRABFOOD_URL ? 'Buka toko & pesan' : 'Minta link toko ke admin',
    href: GRABFOOD_URL || waLink('Boleh minta link toko Hanasari di GrabFood dan info ketersediaannya?', 'GrabFood'), mark: 'G'
  },
  {
    key: 'ekatalog', title: 'E-Katalog', text: 'Pengadaan instansi via INAPROC',
    href: waLink('Saya ingin informasi pemesanan Hanasari melalui E-Katalog.', 'E-Katalog'), mark: 'img'
  }
];
---
<section id="cara-pesan" class="o1-section o1-order" aria-labelledby="o1-order-title">
  <div class="o1-container">
    <div class="o1-order__head" data-reveal>
      <p class="o1-eyebrow">Cara pesan</p>
      <h2 id="o1-order-title" class="o1-h2">Anda siapkan momennya. Kami bantu <em>sajiannya.</em></h2>
    </div>

    <div class="o1-order__grid">
      <ol class="o1-order__steps">
        {steps.map((step, i) => (
          <li class="o1-step" data-reveal style={`--d:${i * 120}ms`}>
            <span class="o1-step__icon"><Icon name={step.icon} size={22} /></span>
            <p class="o1-step__num">Langkah {String(i + 1).padStart(2, '0')}</p>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))}
      </ol>

      <div class="o1-order__panel" data-reveal>
        <p class="o1-order__label">Mulai pesan lewat</p>
        <a class="o1-channel o1-channel--wa" href={waLink('Saya ingin memesan catering Hanasari.', 'Cara pesan — WhatsApp')} target="_blank" rel="noopener noreferrer">
          <span class="o1-channel__mark" aria-hidden="true"><Icon name="whatsapp" size={24} /></span>
          <span class="o1-channel__text">
            <strong>WhatsApp admin<em>Paling cepat</em></strong>
            <small>Tanya menu, harga, dan jadwal langsung ke admin.</small>
          </span>
          <Icon name="arrow" size={18} class="o1-channel__arrow" />
        </a>
        <ul class="o1-order__channels">
          {channels.map((c) => (
            <li>
              <a class:list={['o1-channel', 'o1-channel--compact', `o1-channel--${c.key}`]} href={c.href} target="_blank" rel="noopener noreferrer">
                <span class="o1-channel__mark" aria-hidden="true">
                  {c.mark === 'G' && 'G'}
                  {c.mark === 'img' && <img src={asset('inaproc-icon.webp')} alt="" width="96" height="96" loading="lazy" />}
                </span>
                <span class="o1-channel__text"><strong>{c.title}</strong><small>{c.text}</small></span>
              </a>
            </li>
          ))}
        </ul>
        <div class="o1-order__foot">
          <a class="o1-link" href="#konsultasi">Rencanakan lewat formulir <Icon name="arrow" size={16} /></a>
          <a class="o1-order__more" href={LINKS_URL} target="_blank" rel="noopener noreferrer"><Icon name="link" size={16} /> Semua link Hanasari</a>
        </div>
      </div>
    </div>
  </div>
</section>
