---
/*
 * Ikon ilustrasi berwarna untuk keunggulan Hanasari (TrustStrip).
 * Bentuk datar dengan palet brand (hijau, oranye, emas) agar lebih hidup daripada ikon garis.
 */
interface Props {
  name: 'halal' | 'nusantara' | 'momen' | 'menu';
  size?: number;
}
const { name, size = 30 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 48 48" aria-hidden="true" focusable="false">
  {name === 'halal' && (
    <>
      <path d="M24 4.5 39.5 10v11.6c0 9.8-6.5 17.7-15.5 21.9-9-4.2-15.5-12.1-15.5-21.9V10L24 4.5Z" fill="#309c31" />
      <path d="M24 4.5 39.5 10v11.6c0 9.8-6.5 17.7-15.5 21.9V4.5Z" fill="#237a25" />
      <path d="m16.5 24.2 5.1 5.1 10.2-11.2" fill="none" stroke="#fff" stroke-width="3.6" stroke-linecap="round" stroke-linejoin="round" />
      <path d="M39 3.5c.5 2.4 1.6 3.5 4 4-2.4.5-3.5 1.6-4 4-.5-2.4-1.6-3.5-4-4 2.4-.5 3.5-1.6 4-4Z" fill="#dcaf5f" />
    </>
  )}
  {name === 'nusantara' && (
    <>
      <g transform="translate(5 -5)">
        <path d="M6.5 40.5c3.6-6.6 10.2-9.6 16.4-7.9-3.6 5.9-10.2 8.9-16.4 7.9Z" fill="#7cc576" />
        <path d="M8.5 39.4c3.9-2.6 8.4-4.4 12.5-5.2" fill="none" stroke="#309c31" stroke-width="1.4" stroke-linecap="round" />
      </g>
      <path d="M15.6 17.4c5.8-2 13.2.5 18.3 7 4.1 5.2 5.4 11.5 4.1 15.6-.4 1.1-1.8 1.2-2.4.2-3.1-5.2-8.2-9.6-14.4-12.3-3.5-1.5-6.1-4-6.6-6.8-.3-1.7.2-3.2 1-3.7Z" fill="#e5482d" />
      <path d="M20.5 20.6c4.6-.2 9.4 2.2 12.7 6.4" fill="none" stroke="#f6a089" stroke-width="2" stroke-linecap="round" />
      <path d="M10.6 15.4c1.7-2.7 5.6-3.1 7.7-.8 1.1 1.2.8 2.9-.7 3.5-2.4.9-5.1.9-6.7-.2-.7-.5-.8-1.6-.3-2.5Z" fill="#309c31" />
      <path d="M14.3 13.4c-.7-3.1.6-6.2 3.7-7.8" fill="none" stroke="#237a25" stroke-width="2.6" stroke-linecap="round" />
    </>
  )}
  {name === 'momen' && (
    <>
      <path d="M24 17c-4-8.2-13.5-9.4-13.5-3.3 0 4.1 7 4.3 13.5 3.3Z" fill="#c8932f" />
      <path d="M24 17c4-8.2 13.5-9.4 13.5-3.3 0 4.1-7 4.3-13.5 3.3Z" fill="#dcaf5f" />
      <rect x="9" y="25.5" width="30" height="18" rx="3" fill="#f5a14d" />
      <rect x="9" y="25.5" width="30" height="2.6" fill="#d9701b" opacity=".45" />
      <rect x="6" y="16.5" width="36" height="10" rx="3" fill="#ea7a1f" />
      <rect x="21" y="16.5" width="6" height="27" fill="#dcaf5f" />
      <circle cx="24" cy="17" r="2.6" fill="#c8932f" />
    </>
  )}
  {name === 'menu' && (
    <>
      <rect x="5.5" y="10" width="37" height="28.5" rx="6.5" fill="#309c31" />
      <rect x="5.5" y="10" width="37" height="28.5" rx="6.5" fill="none" stroke="#237a25" stroke-width="1.5" />
      <rect x="9.5" y="14" width="16.5" height="20.5" rx="3.5" fill="#fbf8f1" />
      <circle cx="17.8" cy="24.2" r="2.4" fill="#e5482d" />
      <path d="M19.6 21.4c1.6-1.6 3.6-1.9 4.6-1.4-.6 1.6-2.4 2.6-4.6 1.4Z" fill="#7cc576" />
      <rect x="29" y="14" width="9.5" height="9" rx="2.5" fill="#ea7a1f" />
      <rect x="29" y="25.5" width="9.5" height="9" rx="2.5" fill="#f2c94c" />
    </>
  )}
</svg>
