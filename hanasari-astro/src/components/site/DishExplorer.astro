---
/*
 * "Racik isi box": foto racikan Paket Ningrat dengan penanda bernomor, lalu penjelajah isi per kategori.
 * Jumlah per kategori cukup tampil di tombol filter; ajakan memesan cukup satu kalimat di lead.
 */
import Icon from './Icon.astro';
import { dishGroups, productImg } from './data';

/* Contoh racikan Paket Ningrat (foto dokumentasi). Posisi penanda dalam persen terhadap foto 4:3. */
const anatomy = [
  { label: 'Nasi', x: 36, y: 55 },
  { label: 'Lauk utama 1', x: 76, y: 30 },
  { label: 'Lauk utama 2', x: 74, y: 64 },
  { label: 'Tumisan', x: 49, y: 10 },
  { label: 'Gorengan', x: 29, y: 15 },
  { label: 'Sambal', x: 56, y: 26 },
  { label: 'Buah', x: 11, y: 50 }
];
---
<section id="racik-isi-box" class="o1-dishes" aria-labelledby="o1-dishes-title">
  <div class="o1-dishes__decor" aria-hidden="true"></div>
  <div class="o1-container">
    <div class="o1-dishes__head" data-reveal>
      <div>
        <p class="o1-eyebrow o1-eyebrow--light">Racik isi box</p>
        <h2 id="o1-dishes-title" class="o1-h2 o1-h2--light">Bebas pilih menu. <em>Sesuai selera.</em></h2>
      </div>
      <p class="o1-dishes__lead">Semua paket nasi box dan snack box bisa diisi lauk, tumisan, sambal, dan snack pilihan Anda.</p>
    </div>

    <div class="o1-dishes__body">
      <figure class="o1-anatomy" data-reveal>
        <div class="o1-anatomy__photo">
          <img src={productImg('nasi-box/racik-paket-ningrat.webp')} alt="Contoh racikan Paket Ningrat dalam Hanasari Lunch Box: nasi, dua lauk utama, tumisan, gorengan, sambal, dan pisang" width="1100" height="825" loading="lazy" decoding="async" />
          {anatomy.map((spot, i) => <span class="o1-anatomy__dot" style={`--x:${spot.x}%;--y:${spot.y}%;--i:${i}`} aria-hidden="true">{i + 1}</span>)}
        </div>
        <figcaption>
          <strong>Contoh racikan Paket Ningrat</strong>
          <ol>{anatomy.map((spot) => <li>{spot.label}</li>)}</ol>
        </figcaption>
      </figure>

      <div class="o1-dishes__explorer" data-chips data-reveal>
        <div class="o1-dishes__filters" role="tablist" aria-label="Kategori pilihan isi">
          {dishGroups.map((g, i) => (
            <button type="button" role="tab" id={`o1-dish-tab-${g.id}`} aria-controls={`o1-dish-${g.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-chip-tab={g.id}>
              {g.label}<span>{g.items.length}</span>
            </button>
          ))}
        </div>
        {dishGroups.map((g, i) => (
          <div class:list={['o1-dishes__panel', { 'is-active': i === 0 }]} role="tabpanel" id={`o1-dish-${g.id}`} aria-labelledby={`o1-dish-tab-${g.id}`} data-chip-panel={g.id}>
            <h3 class="o1-visually-hidden">{g.label}</h3>
            <ul>
              {g.items.map((item, j) => <li style={`--i:${j}`}>{item}</li>)}
            </ul>
            {g.hint && <p class="o1-dishes__hint">{g.hint}</p>}
          </div>
        ))}
        <div class="o1-dishes__foot">
          <p>*Mengikuti ketersediaan.<br />Favorit pelanggan: Daging Balado Pedas Manis, Ayam Bakar Taliwang, Ikan Gurame Goreng.</p>
          <a class="o1-btn o1-btn--primary o1-btn--sm" href="#konsultasi">
            Racik bersama admin <Icon name="arrow" />
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
