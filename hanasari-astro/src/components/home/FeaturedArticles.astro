---
import ArticleCard from '../ArticleCard.astro';
interface Props { articles: any[]; }
const { articles } = Astro.props;
---
<section id="artikel" class="section article-featured-section">
  <div class="container">
    <div class="section-heading article-heading">
      <div><div class="eyebrow">CERITA DARI DAPUR HANASARI</div><h2>Resep, inspirasi, dan<br /><em>promo terbaru.</em></h2></div>
      <div class="heading-aside"><p>Konten pilihan Hanasari untuk menemani Anda menemukan ide sajian, kabar promo, dan cerita di balik menu.</p><a class="text-link" href="/artikel/">Lihat semua artikel <span aria-hidden="true">↗</span></a></div>
    </div>
    {articles.length > 0 ? <div class="article-grid" id="featured-articles" aria-live="polite">{articles.map(({ data }) => <ArticleCard article={data} />)}</div> : <p class="article-empty">Belum ada artikel pilihan untuk ditampilkan.</p>}
  </div>
</section>
