---
import Icon from './Icon.astro';
import { LINKS_URL, asset, waLink } from './data';

/* Isi GOFOOD_URL / GRABFOOD_URL bila toko resmi sudah tersedia. Jika kosong, tombol meminta link ke admin. */
const GOFOOD_URL = '';
const GRABFOOD_URL = '';

const channels = [
  {
    key: 'wa', title: 'WhatsApp', text: 'Cara tercepat: tanya menu, harga, dan jadwal langsung ke admin.', badge: 'Paling cepat',
    href: waLink('Saya ingin memesan catering Hanasari.', 'Pesan online — WhatsApp'), mark: 'wa'
  },
  {
    key: 'gofood', title: 'GoFood', text: GOFOOD_URL ? 'Buka toko & pesan sekarang' : 'Minta link pemesanan ke admin',
    href: GOFOOD_URL || waLink('Boleh minta link toko Hanasari di GoFood dan info ketersediaannya?', 'GoFood'), mark: 'G'
  },
  {
    key: 'grab', title: 'GrabFood', text: GRABFOOD_URL ? 'Buka toko & pesan sekarang' : 'Minta link pemesanan ke admin',
    href: GRABFOOD_URL || waLink('Boleh minta link toko Hanasari di GrabFood dan info ketersediaannya?', 'GrabFood'), mark: 'G'
  },
  {
    key: 'ekatalog', title: 'E-Katalog', text: 'Untuk kebutuhan pengadaan instansi melalui INAPROC.',
    href: waLink('Saya ingin informasi pemesanan Hanasari melalui E-Katalog.', 'E-Katalog'), mark: 'img'
  },
  {
    key: 'links', title: 'Semua link Hanasari', text: 'Jelajahi kanal dan informasi lainnya.',
    href: LINKS_URL, mark: 'link'
  }
];
---
<section id="pesan-online" class="o1-channels" aria-labelledby="o1-channels-title">
  <div class="o1-container o1-channels__grid">
    <div class="o1-channels__head" data-reveal>
      <p class="o1-eyebrow">Dekat, lewat cara Anda</p>
      <h2 id="o1-channels-title" class="o1-h2">Pesan tanpa <em>ribet.</em></h2>
      <p>Langsung lewat WhatsApp, aplikasi pesan-antar favorit, atau E-Katalog untuk kebutuhan instansi.</p>
    </div>
    <ul class="o1-channels__list">
      {channels.map((c, i) => (
        <li data-reveal style={`--d:${i * 70}ms`}>
          <a class:list={['o1-channel', `o1-channel--${c.key}`]} href={c.href} target="_blank" rel="noopener noreferrer">
            <span class="o1-channel__mark" aria-hidden="true">
              {c.mark === 'wa' && <Icon name="whatsapp" size={24} />}
              {c.mark === 'G' && 'G'}
              {c.mark === 'link' && <Icon name="link" size={22} />}
              {c.mark === 'img' && <img src={asset('inaproc-icon.webp')} alt="" width="96" height="96" loading="lazy" />}
            </span>
            <span class="o1-channel__text">
              <strong>{c.title}{c.badge && <em>{c.badge}</em>}</strong>
              <small>{c.text}</small>
            </span>
            <Icon name="arrow" size={18} class="o1-channel__arrow" />
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
