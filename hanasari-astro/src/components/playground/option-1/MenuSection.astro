---
import Icon from './Icon.astro';
import ProductCard from './ProductCard.astro';
import { categories, products, CATALOG_URL } from './data';

const labelFor = { nasi: 'Nasi Box', snack: 'Snack Box', spesial: 'Sajian Spesial' } as const;
---
<section id="menu" class="o1-section o1-menu" aria-labelledby="o1-menu-title">
  <div class="o1-container">
    <div class="o1-heading" data-reveal>
      <div>
        <p class="o1-eyebrow">Pilihan dari dapur kami</p>
        <h2 id="o1-menu-title" class="o1-h2">Ada sajian untuk <em>setiap kesempatan.</em></h2>
      </div>
      <div class="o1-heading__aside">
        <p>Mau nasi box yang praktis atau tumpeng untuk merayakan? Mulai dari paket yang paling pas, lalu racik isinya bersama admin.</p>
        <a class="o1-link" href={CATALOG_URL} target="_blank" rel="noopener"><Icon name="doc" size={18} /> Unduh katalog lengkap (PDF)</a>
      </div>
    </div>

    <div class="o1-tabs" data-tabs>
      <div class="o1-tabs__bar" data-reveal>
        <div class="o1-tabs__list" role="tablist" aria-label="Kategori menu">
          {categories.map((cat, i) => {
            const count = products.filter((p) => p.category === cat.id).length;
            return (
              <button class="o1-tabs__tab" role="tab" type="button" id={`o1-tab-${cat.id}`} aria-controls={`o1-panel-${cat.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-tab={cat.id}>
                <span class="is-long">{cat.label}</span><span class="is-short">{cat.short}</span><span class="o1-tabs__count">{count}</span>
              </button>
            );
          })}
        </div>
        <div class="o1-slider-nav" aria-label="Geser pilihan menu">
          <button class="o1-round-btn" type="button" data-slide-prev aria-label="Paket sebelumnya"><Icon name="arrow-left" /></button>
          <button class="o1-round-btn" type="button" data-slide-next aria-label="Paket berikutnya"><Icon name="arrow-right" /></button>
        </div>
      </div>

      {categories.map((cat, i) => {
        const list = products.filter((p) => p.category === cat.id);
        return (
          <div class:list={['o1-tabs__panel', { 'is-active': i === 0 }]} role="tabpanel" id={`o1-panel-${cat.id}`} aria-labelledby={`o1-tab-${cat.id}`} data-panel={cat.id}>
            <p class="o1-tabs__intro">{cat.intro}</p>
            <ul class="o1-track" data-track tabindex="0" aria-label={`Pilihan ${cat.label}, geser untuk melihat lainnya`}>
              {list.map((product, index) => <ProductCard product={product} index={index} categoryLabel={labelFor[cat.id]} />)}
            </ul>
            <div class="o1-track__progress" aria-hidden="true"><span data-progress></span></div>
          </div>
        );
      })}
    </div>

    <p class="o1-menu__note">
      Harga mengacu pada katalog Agustus 2026. Konfirmasikan harga, isi paket, dan ketersediaan kepada admin sebelum memesan. Foto merupakan contoh penyajian.
    </p>
  </div>
</section>
