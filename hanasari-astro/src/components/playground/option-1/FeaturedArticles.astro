---
import Icon from './Icon.astro';

interface ArticleData {
  title: string;
  slug: string;
  category: string;
  publishDate: Date;
  excerpt: string;
  thumbnail: string;
  thumbnailAlt: string;
}

interface Props {
  articles: ArticleData[];
}

const { articles } = Astro.props;
const fmt = new Intl.DateTimeFormat('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
---
<section id="artikel" class="o1-section o1-articles" aria-labelledby="o1-articles-title">
  <div class="o1-container">
    <div class="o1-heading" data-reveal>
      <div>
        <p class="o1-eyebrow">Cerita dari dapur Hanasari</p>
        <h2 id="o1-articles-title" class="o1-h2">Resep, inspirasi, dan <em>promo terbaru.</em></h2>
      </div>
      <div class="o1-heading__aside">
        <p>Konten pilihan Hanasari untuk menemani Anda menemukan ide sajian, kabar promo, dan cerita di balik menu.</p>
        <a class="o1-link" href="/artikel/">Lihat semua artikel <Icon name="arrow" size={18} /></a>
      </div>
    </div>

    {articles.length > 0 ? (
      <div class="o1-articles__grid">
        {articles.map((article, i) => (
          <article class="o1-article" data-reveal style={`--d:${i * 100}ms`}>
            <a class="o1-article__media" href={`/artikel/${article.slug}/`} tabindex="-1" aria-hidden="true">
              <img src={article.thumbnail} alt="" width="800" height="1000" loading="lazy" decoding="async" />
            </a>
            <div class="o1-article__body">
              <p class="o1-article__meta"><span>{article.category}</span><time datetime={article.publishDate.toISOString()}>{fmt.format(article.publishDate)}</time></p>
              <h3><a href={`/artikel/${article.slug}/`}>{article.title}</a></h3>
              <p class="o1-article__excerpt">{article.excerpt}</p>
              <span class="o1-article__more" aria-hidden="true">Baca selengkapnya <Icon name="arrow" size={16} /></span>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <p class="o1-articles__empty">Belum ada artikel pilihan untuk ditampilkan.</p>
    )}
  </div>
</section>
