---
import Icon from './Icon.astro';

const steps = [
  { icon: 'cart', title: 'Pilih sajian favorit', text: 'Jelajahi pilihan paket atau ceritakan menu yang Anda inginkan.' },
  { icon: 'chat', title: 'Diskusikan kebutuhan', text: 'Informasikan tanggal, jumlah porsi, anggaran, dan lokasi acara melalui WhatsApp.' },
  { icon: 'check', title: 'Konfirmasi & nikmati', text: 'Sepakati rincian pesanan, pembayaran, dan pengiriman bersama admin.' }
] as const;
---
<section id="cara-pesan" class="o1-section o1-steps" aria-labelledby="o1-steps-title">
  <div class="o1-container">
    <div class="o1-heading" data-reveal>
      <div>
        <p class="o1-eyebrow">Gampang dari awal</p>
        <h2 id="o1-steps-title" class="o1-h2">Anda siapkan momennya. Kami bantu <em>sajiannya.</em></h2>
      </div>
      <div class="o1-heading__aside">
        <p>Tiga langkah sederhana dari memilih menu sampai sajian tiba di lokasi acara Anda.</p>
        <a class="o1-btn o1-btn--dark o1-btn--sm" href="#konsultasi">Rencanakan pesanan <Icon name="arrow" size={16} /></a>
      </div>
    </div>

    <div class="o1-steps__wrap" data-steps>
      <svg class="o1-steps__line" viewBox="0 0 1000 40" preserveAspectRatio="none" aria-hidden="true"><path d="M0 20 H1000" /></svg>
      <ol class="o1-steps__list">
      {steps.map((step, i) => (
        <li class="o1-step" data-reveal style={`--d:${i * 120}ms`}>
          <span class="o1-step__icon"><Icon name={step.icon} size={24} /></span>
          <p class="o1-step__num">Langkah {String(i + 1).padStart(2, '0')}</p>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </li>
      ))}
      </ol>
    </div>
  </div>
</section>
