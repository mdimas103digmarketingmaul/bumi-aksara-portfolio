---
interface Props {
  option: number;
  label?: string;
}

const { option, label = `Visual Option ${option}` } = Astro.props;
const prev = option > 1 ? `/playground/option-${option - 1}/` : null;
const next = option < 4 ? `/playground/option-${option + 1}/` : null;
---
<div class="option-shell">
  <header class="option-toolbar">
    <a class="back-link" href="/playground/">← Semua opsi</a>
    <div class="option-toolbar__meta">
      <span>Hanasari Catering</span>
      <strong>{label}</strong>
    </div>
    <a class="production-link" href="/" target="_blank" rel="noreferrer">Production ↗</a>
  </header>

  <main class="option-stage">
    <section class="option-placeholder">
      <p class="eyebrow">PLAYGROUND / OPTION {String(option).padStart(2, '0')}</p>
      <h1>{label}</h1>
      <p>
        Struktur route sudah siap. Homepage alternatif untuk opsi ini akan dibangun di halaman ini
        tanpa mengubah homepage production Hanasari.
      </p>
      <div class="placeholder-box">
        <span>AREA DESAIN HOMEPAGE OPTION {option}</span>
      </div>
    </section>
  </main>

  <nav class="option-switcher" aria-label="Navigasi opsi playground">
    <div>
      {prev && <a href={prev}>← Option {option - 1}</a>}
    </div>
    <a href="/playground/">Overview</a>
    <div class="option-switcher__right">
      {next && <a href={next}>Option {option + 1} →</a>}
    </div>
  </nav>
</div>

<style>
  .option-shell {
    min-height: 100vh;
  }

  .option-toolbar {
    position: sticky;
    top: 0;
    z-index: 100;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 20px;
    padding: 14px clamp(18px, 4vw, 56px);
    background: rgba(15, 40, 39, 0.96);
    color: #fff;
    backdrop-filter: blur(12px);
  }

  .option-toolbar a {
    color: inherit;
    text-decoration: none;
    font-size: 13px;
    font-weight: 700;
  }

  .option-toolbar__meta {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 12px;
  }

  .option-toolbar__meta span {
    opacity: 0.65;
  }

  .production-link {
    justify-self: end;
  }

  .option-stage {
    display: grid;
    place-items: center;
    min-height: calc(100vh - 120px);
    padding: clamp(34px, 6vw, 90px) clamp(18px, 5vw, 72px);
  }

  .option-placeholder {
    width: min(980px, 100%);
  }

  .eyebrow {
    margin: 0 0 16px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.15em;
  }

  h1 {
    margin: 0;
    font-size: clamp(42px, 7vw, 88px);
    line-height: 0.95;
    letter-spacing: -0.04em;
  }

  .option-placeholder > p:not(.eyebrow) {
    max-width: 700px;
    margin: 24px 0 34px;
    font-size: clamp(16px, 2vw, 20px);
    line-height: 1.65;
  }

  .placeholder-box {
    display: grid;
    place-items: center;
    min-height: 320px;
    border: 1px dashed rgba(23, 58, 56, 0.35);
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.5);
    text-align: center;
  }

  .placeholder-box span {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.14em;
    opacity: 0.55;
  }

  .option-switcher {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 16px;
    padding: 20px clamp(18px, 4vw, 56px) 28px;
    border-top: 1px solid rgba(23, 58, 56, 0.12);
  }

  .option-switcher a {
    color: #173a38;
    font-size: 13px;
    font-weight: 800;
    text-decoration: none;
  }

  .option-switcher__right {
    text-align: right;
  }

  @media (max-width: 700px) {
    .option-toolbar {
      grid-template-columns: 1fr auto;
    }

    .option-toolbar__meta {
      display: none;
    }

    .option-stage {
      min-height: calc(100vh - 108px);
    }

    .placeholder-box {
      min-height: 220px;
    }
  }
</style>
