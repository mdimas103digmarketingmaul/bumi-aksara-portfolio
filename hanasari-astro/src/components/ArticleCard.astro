---
interface Props {
  article: {
    title: string;
    slug: string;
    category: string;
    publishDate: Date;
    excerpt: string;
    thumbnail: string;
    thumbnailAlt: string;
  };
  compact?: boolean;
}
const { article, compact = false } = Astro.props;
const formattedDate = new Intl.DateTimeFormat('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }).format(article.publishDate);
---
<article class:list={['article-card', { compact }]} data-category={article.category}>
  <a class="article-card-media" href={`/artikel/${article.slug}/`} aria-label={`Baca ${article.title}`}><img src={article.thumbnail} alt={article.thumbnailAlt} loading="lazy" /></a>
  <div class="article-card-body">
    <div class="article-meta"><span>{article.category}</span><time datetime={article.publishDate.toISOString()}>{formattedDate}</time></div>
    <h3><a href={`/artikel/${article.slug}/`}>{article.title}</a></h3>
    <p>{article.excerpt}</p>
    <a class="article-read" href={`/artikel/${article.slug}/`}>Baca selengkapnya <span aria-hidden="true">↗</span></a>
  </div>
</article>
