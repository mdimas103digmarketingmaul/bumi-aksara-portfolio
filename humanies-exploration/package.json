{
  "name": "humanies-exploration",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:deploy": "tsc -b && vite build --outDir deploy --emptyOutDir",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "build:showcase": "tsc -b && vite build --mode showcase",
    "prepare:pages": "npm run build:deploy && node scripts/prepare-pages-preview.mjs",
    "preview:pages": "npx --yes wrangler@4.152.0 pages dev . --cwd .pages-preview --ip 127.0.0.1 --port 8788 --compatibility-date 2026-09-26",
    "test": "node --test tests/bmkg.test.mjs tests/weather-proxy.test.mjs tests/petabencana.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "lucide-react": "^1.65.0",
    "maplibre-gl": "^6.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
