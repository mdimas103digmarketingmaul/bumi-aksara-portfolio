---
import Icon from './Icon.astro';
import ArticleCard from './ArticleCard.astro';

interface ArticleData {
  title: string;
  slug: string;
  category: string;
  publishDate: Date;
  excerpt: string;
  thumbnail: string;
  thumbnailAlt: string;
}

interface Props {
  articles: ArticleData[];
}

const { articles } = Astro.props;
---
<section id="artikel" class="o1-section o1-articles" aria-labelledby="o1-articles-title">
  <div class="o1-container">
    <div class="o1-heading" data-reveal>
      <div>
        <p class="o1-eyebrow">Cerita dari dapur Hanasari</p>
        <h2 id="o1-articles-title" class="o1-h2">Resep, inspirasi, dan <em>promo terbaru.</em></h2>
      </div>
      <div class="o1-heading__aside">
        <a class="o1-link" href="/artikel/">Lihat semua artikel <Icon name="arrow" size={18} /></a>
      </div>
    </div>

    {articles.length > 0 ? (
      <div class="o1-articles__grid">
        {articles.map((article, i) => <ArticleCard article={article} delay={i * 100} />)}
      </div>
    ) : (
      <p class="o1-articles__empty">Belum ada artikel pilihan untuk ditampilkan.</p>
    )}
  </div>
</section>
